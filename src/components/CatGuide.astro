---
import CatPose, { type CatPoseName } from "./CatPose.astro";
interface Props {
  pose?: CatPoseName;
  title?: string;
}
const { pose = "investigate", title } = Astro.props;
---

<div
  class:list={[
    "cat-guide",
    `cat-guide--${pose}`,
    { "cat-guide--inline": pose !== "peek" && pose !== "investigate" },
  ]}
  data-cat-guide={pose}
>
  <CatPose pose={pose} class="cat-guide-art" />
  <div class="cat-guide-copy">
    {title && <p class="cat-guide-title">{title}</p>}
    <slot />
  </div>
</div>
