---
interface Props {
  pose?: "investigate" | "peek";
  title?: string;
}
const { pose = "investigate", title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const stem = pose === "peek" ? "cat-peek" : "cat-investigate";
---

<div class:list={["cat-guide", `cat-guide--${pose}`]} data-cat-guide={pose}>
  <img
    class="cat-guide-art"
    src={`${base}/brand/${stem}-320.webp`}
    srcset={`${base}/brand/${stem}-320.webp 320w, ${base}/brand/${stem}-640.webp 640w`}
    sizes="176px"
    width="640"
    height="427"
    loading="lazy"
    decoding="async"
    alt=""
    aria-hidden="true"
  />
  <div class="cat-guide-copy">
    {title && <p class="cat-guide-title">{title}</p>}
    <slot />
  </div>
</div>
