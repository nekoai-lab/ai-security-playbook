---
import { getCollection } from "astro:content";
import { levels, levelDetails, type topicIds } from "../data/catalog";
import TopicCards from "./TopicCards.astro";
import TopicLessonCard from "./TopicLessonCard.astro";
interface Props {
  topic?: (typeof topicIds)[number];
}
const { topic } = Astro.props;
const lessons = (await getCollection("lessons"))
  .filter((l) => !topic || l.data.topic === topic)
  .sort(
    (a, b) =>
      levels.indexOf(a.data.level) - levels.indexOf(b.data.level) ||
      a.data.prerequisites.length - b.data.prerequisites.length ||
      a.id.localeCompare(b.id),
  );
---

<div
  class="discovery"
  data-inline-discovery
  data-discovery-mode={topic ? "topic" : "home"}
>
  <form
    class="discovery-form"
    role="search"
    aria-label="教材を探す"
    method="get"
  >
    {!topic && (
      <div class="discovery-search">
        <div class="discovery-searchfield">
          <label for="discovery-query">教材を検索</label>
          <input
            id="discovery-query"
            name="q"
            type="search"
            maxlength="200"
            placeholder="例：会社のAI、APIキー、ログイン"
            disabled
          />
        </div>
        <button type="submit" disabled>
          検索する
        </button>
      </div>
    )}
    <div class="discovery-levels" aria-label="教材の段階で絞る">
      <button type="button" data-filter-level="" aria-pressed="true" disabled>
        すべて <span>({lessons.length})</span>
      </button>
      {levels.map((level) => (
        <button
          type="button"
          data-filter-level={level}
          aria-pressed="false"
          data-available={lessons.filter((l) => l.data.level === level).length}
          disabled
        >
          <strong>
            {level} ({lessons.filter((l) => l.data.level === level).length})
          </strong>
          <span class="level-description">{levelDetails[level].label}</span>
        </button>
      ))}
    </div>
    <p class="discovery-hint">
      段階は教材の前提です。迷ったら「すべて」のままで選べます。
    </p>
    <noscript>
      <p class="discovery-hint">
        すべての段階を表示しています。テーマ名や記事名から選べます。
      </p>
    </noscript>
  </form>
  <p
    class="discovery-status"
    data-discovery-status
    role="status"
    aria-live="polite"
  >
    {lessons.length}件の教材
  </p>
  <div data-discovery-empty hidden>
    <p>
      条件に合う教材がありません。検索語を短くするか、条件を解除してください。
    </p>
    <div data-discovery-broaden hidden>
      <p data-discovery-broaden-count></p>
      <button type="button" data-discovery-all-levels>
        検索語を残して、すべての段階で探す
      </button>
    </div>
    <button type="button" data-discovery-reset>
      条件を解除する
    </button>
  </div>
  {topic ? (
    <div class="discovery-list">
      {lessons.map((lesson) => (
        <TopicLessonCard lesson={lesson} />
      ))}
    </div>
  ) : (
    <>
      <div data-discovery-results hidden>
        <h3 class="results-title">検索結果</h3>
        <div class="discovery-list">
          {lessons.map((lesson) => (
            <TopicLessonCard lesson={lesson} headingLevel="h4" />
          ))}
        </div>
      </div>
      <div id="themes">
        <TopicCards headingLevel="h3" />
      </div>
    </>
  )}
</div>
<script>
  import { matchesSearch, normalizeLevel, levels } from "../data/catalog";
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-inline-discovery]",
  )) {
    const form = root.querySelector<HTMLFormElement>("form")!;
    const query = root.querySelector<HTMLInputElement>("input[name=q]");
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-filter-level]"),
    );
    const lessons = Array.from(
      root.querySelectorAll<HTMLElement>("[data-discovery-lesson]"),
    );
    const topics = Array.from(
      root.querySelectorAll<HTMLElement>("[data-discovery-topic]"),
    );
    const results = root.querySelector<HTMLElement>("[data-discovery-results]");
    const empty = root.querySelector<HTMLElement>("[data-discovery-empty]")!;
    const status = root.querySelector<HTMLElement>("[data-discovery-status]")!;
    let level = "";
    let timer: ReturnType<typeof setTimeout>;
    const match = (e: HTMLElement) => !level || e.dataset.level === level;
    function render() {
      const q = query?.value.trim() ?? "";
      let count = 0;
      for (const item of lessons) {
        const show = match(item) && matchesSearch(item.dataset.search ?? "", q);
        item.hidden = !show;
        if (show) count++;
      }
      for (const card of topics) {
        const matches = Array.from(
          card.querySelectorAll<HTMLElement>("[data-topic-example]"),
        ).filter((e) => match(e) && matchesSearch(e.dataset.search ?? "", q));
        card.hidden = matches.length === 0;
        for (const e of card.querySelectorAll<HTMLElement>(
          "[data-topic-example]",
        ))
          e.hidden = !matches.slice(0, 2).includes(e);
        card.querySelector<HTMLElement>("[data-topic-count]")!.textContent =
          String(matches.length);
        const destination =
          matches.length === 1
            ? matches[0]
                .querySelector<HTMLAnchorElement>("a")!
                .getAttribute("href")!
            : card.dataset.topicUrl! +
              (level ? `?level=${encodeURIComponent(level)}` : "");
        for (const a of card.querySelectorAll<HTMLAnchorElement>(
          "[data-topic-destination]",
        ))
          a.setAttribute("href", destination);
        const action = card.querySelector<HTMLElement>("[data-topic-action]")!;
        action.textContent =
          (matches.length === 1 ? "この記事を読む" : "このテーマを見る") + " →";
      }
      if (results) results.hidden = !q;
      const themeGrid = root.querySelector<HTMLElement>("#themes");
      if (themeGrid) themeGrid.hidden = !!q;
      empty.hidden = count > 0;
      const broaden = root.querySelector<HTMLElement>(
        "[data-discovery-broaden]",
      )!;
      const keywordCount = q
        ? lessons.filter((item) => matchesSearch(item.dataset.search ?? "", q))
            .length
        : 0;
      broaden.hidden = count > 0 || keywordCount === 0;
      root.querySelector<HTMLElement>(
        "[data-discovery-broaden-count]",
      )!.textContent =
        `同じ検索語で、すべての段階なら${keywordCount}件見つかります。`;
      status.textContent =
        (level ? `${level} · ` : "") +
        (q ? `「${q}」に合う${count}件` : `${count}件の教材`);
      for (const b of buttons) {
        b.disabled =
          b.dataset.filterLevel !== "" && Number(b.dataset.available) === 0;
        b.setAttribute("aria-pressed", String(b.dataset.filterLevel === level));
      }
      document.dispatchEvent(
        new CustomEvent("lesson-discovery-change", {
          detail: { level, query: q },
        }),
      );
    }
    function readURL() {
      const params = new URL(location.href).searchParams;
      const value = normalizeLevel(params.get("level") ?? "");
      level = (levels as readonly string[]).includes(value) ? value : "";
      if (
        buttons.find((b) => b.dataset.filterLevel === level)?.dataset
          .available === "0"
      )
        level = "";
      if (query) query.value = (params.get("q") ?? "").slice(0, 200);
      render();
    }
    function writeURL(push: boolean) {
      const url = new URL(location.href);
      const q = query?.value.trim() ?? "";
      if (q) url.searchParams.set("q", q);
      else url.searchParams.delete("q");
      if (level) url.searchParams.set("level", level);
      else url.searchParams.delete("level");
      if (url.href !== location.href)
        history[push ? "pushState" : "replaceState"](null, "", url);
    }
    form
      .querySelectorAll<HTMLInputElement | HTMLButtonElement>("[disabled]")
      .forEach((e) => (e.disabled = false));
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      clearTimeout(timer);
      render();
      writeURL(true);
    });
    query?.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        render();
        writeURL(false);
      }, 150);
    });
    for (const b of buttons)
      b.addEventListener("click", () => {
        clearTimeout(timer);
        level = b.dataset.filterLevel ?? "";
        render();
        writeURL(true);
      });
    root
      .querySelector("[data-discovery-reset]")
      ?.addEventListener("click", () => {
        clearTimeout(timer);
        level = "";
        if (query) query.value = "";
        render();
        writeURL(true);
        query?.focus();
      });
    root
      .querySelector("[data-discovery-all-levels]")
      ?.addEventListener("click", () => {
        clearTimeout(timer);
        level = "";
        render();
        writeURL(true);
        query?.focus();
      });
    window.addEventListener("popstate", () => {
      clearTimeout(timer);
      readURL();
    });
    readURL();
    writeURL(false);
  }
</script>
<style>
  .discovery-search {
    display: flex;
    align-items: end;
    gap: 16px;
    background: var(--color-paper-light);
    padding: 16px;
    margin-bottom: 16px;
  }
  .discovery-search label {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    line-height: 1.6;
  }
  .discovery-search input {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 12px 16px;
    background: var(--color-paper-light);
    border: 1px solid var(--color-line-strong);
    font: inherit;
    font-size: 16px;
    line-height: 1.6;
  }
  .discovery-search button {
    background: var(--color-ink);
    color: var(--color-paper-light);
    padding: 12px 24px;
    min-height: 48px;
    border: 0;
    font-size: 16px;
    line-height: 1.6;
  }
  .discovery-levels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .discovery-levels button {
    min-height: 44px;
    padding: 12px 16px;
    border: 1px solid var(--color-line-strong);
    background: transparent;
    color: var(--color-ink);
    font-size: 12px;
    line-height: 1.6;
    text-align: left;
  }
  .discovery-levels button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper-light);
  }
  .discovery-levels button:disabled {
    opacity: 0.6;
  }
  .discovery-hint,
  .discovery-status {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 12px 0;
    text-wrap: balance;
  }
  .discovery-status {
    margin-bottom: 24px;
  }
  .discovery-list {
    display: grid;
    gap: 16px;
  }
  .results-title {
    font-size: 24px;
    line-height: 1.6;
    margin: 24px 0 16px;
  }
  .discovery [data-discovery-results] {
    margin-bottom: 32px;
  }
  .discovery :global([hidden]) {
    display: none !important;
  }
  [data-discovery-empty] {
    font-size: 16px;
    line-height: 1.9;
    padding: 24px;
    background: var(--color-paper-light);
  }
  [data-discovery-empty] button {
    min-height: 44px;
    padding: 8px 16px;
  }
  @media (max-width: 760px) {
    .discovery-search {
      gap: 8px;
      padding: 12px;
    }
    .discovery-search button {
      font-size: 12px;
      padding: 12px;
      white-space: nowrap;
    }
    .discovery-levels {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .discovery-levels button {
      padding: 12px;
      min-width: 0;
    }
  }
</style>

<style>
  .discovery-searchfield {
    flex: 1;
    min-width: 0;
  }
  .discovery-levels strong {
    font-weight: inherit;
  }
  .level-description {
    margin-left: 8px;
  }
  @media (max-width: 760px) {
    .discovery-levels strong,
    .level-description {
      display: block;
    }
    .level-description {
      margin-left: 0;
      text-wrap: balance;
    }
  }
</style>
