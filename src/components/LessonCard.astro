---
import type { CollectionEntry } from "astro:content";
import CardArt from "./CardArt.astro";
import { lessonCardArt } from "../data/card-art";
import LessonCardCopy from "./LessonCardCopy.astro";
import { type LessonVisualId } from "../data/lesson-visuals";
interface Props {
  lesson: CollectionEntry<"lessons">;
  route?: string;
  headingLevel?: "h2" | "h3";
  poster?: boolean;
}
const { lesson, route, headingLevel = "h2" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/learn/${lesson.id}/${route ? `?route=${encodeURIComponent(route)}` : ""}`;
---

<article
  class="catalog-card catalog-card--poster image-card"
  data-catalog-item
  data-topic={lesson.data.topic}
  data-level={lesson.data.level}
  data-type={lesson.data.format}
  data-search={[
    lesson.data.title,
    lesson.data.summary,
    ...lesson.data.keywords,
  ].join(" ")}
>
  <CardArt
    art={lessonCardArt(lesson.id as LessonVisualId)}
    sizes="(max-width:760px) calc(100vw - 32px), (max-width:1100px) 50vw, 33vw"
  />
  <div class="catalog-card-content card-copy">
    <LessonCardCopy lesson={lesson} href={href} headingLevel={headingLevel} />
  </div>
</article>
<style>
  .catalog-card-content {
    min-width: 0;
  }
  .catalog-card-content :global(p:not(.catalog-meta)) {
    font-size: 16px;
    line-height: 1.9;
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .catalog-card-content :global(.catalog-meta) {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .catalog-card-content :global(.catalog-meta:last-child) {
    margin: 0;
  }
</style>
