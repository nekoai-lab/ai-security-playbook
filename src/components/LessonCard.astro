---
import type { CollectionEntry } from "astro:content";
import ReadingArt from "./ReadingArt.astro";
import CardArt from "./CardArt.astro";
import { lessonCardArt } from "../data/card-art";
import LessonCardCopy from "./LessonCardCopy.astro";
import {
  readingHighlights,
  type ReadingHighlightId,
} from "../data/reading-highlights";
import { lessonVisuals, type LessonVisualId } from "../data/lesson-visuals";
interface Props {
  lesson: CollectionEntry<"lessons">;
  route?: string;
  headingLevel?: "h2" | "h3";
  poster?: boolean;
}
const { lesson, route, headingLevel = "h2", poster = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/learn/${lesson.id}/${route ? `?route=${encodeURIComponent(route)}` : ""}`;
---

<article
  class:list={[
    "catalog-card",
    {
      "catalog-card--illustrated": !poster && lesson.id in readingHighlights,
      "catalog-card--poster": poster,
      "catalog-card--pose":
        poster && lessonCardArt(lesson.id as LessonVisualId).kind === "pose",
    },
  ]}
  data-catalog-item
  data-topic={lesson.data.topic}
  data-level={lesson.data.level}
  data-type={lesson.data.format}
  data-search={[
    lesson.data.title,
    lesson.data.summary,
    ...lesson.data.keywords,
  ].join(" ")}
>
  {poster ? (
    <>
      {lesson.id in lessonVisuals && (
        <CardArt
          art={lessonCardArt(lesson.id as LessonVisualId)}
          sizes="(max-width:760px) calc(100vw - 32px), (max-width:1100px) 50vw,400px"
        />
      )}
      <div class="catalog-card-content">
        <LessonCardCopy
          lesson={lesson}
          href={href}
          headingLevel={headingLevel}
        />
      </div>
    </>
  ) : (
    <>
      {lesson.id in readingHighlights && (
        <ReadingArt
          id={lesson.id as ReadingHighlightId}
          sizes="(max-width:760px) 100vw,240px"
        />
      )}
      <LessonCardCopy lesson={lesson} href={href} headingLevel={headingLevel} />
    </>
  )}
</article>
<style>
  .catalog-card--poster {
    padding: 0;
    border: 0;
    background: var(--color-paper-light);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .catalog-card--poster > :global(.card-art) {
    width: 100%;
    height: 128px;
    margin: 0;
    float: none;
  }
  .catalog-card--pose > :global(.card-art) {
    width: 144px;
    height: 128px;
    align-self: flex-end;
    margin: 12px 16px 0;
  }
  .catalog-card--pose:nth-child(even) > :global(.card-art) {
    align-self: flex-start;
  }
  .catalog-card-content {
    padding: 24px;
    min-width: 0;
  }
  .catalog-card-content :global(p:not(.catalog-meta)) {
    font-size: 16px;
    line-height: 1.9;
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .catalog-card-content :global(.catalog-meta) {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .catalog-card-content :global(.catalog-meta:last-child) {
    margin: 0;
  }
  @media (max-width: 760px) {
    .catalog-card-content {
      padding: 16px;
    }
  }
</style>
