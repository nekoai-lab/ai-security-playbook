---
import { getCollection } from "astro:content";
import { topics, levels } from "../data/catalog";
import CardArt from "./CardArt.astro";
import { topicCompositions } from "../data/card-art";
interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel: Heading = "h2" } = Astro.props;
const lessons = (await getCollection("lessons")).sort(
  (a, b) =>
    levels.indexOf(a.data.level) - levels.indexOf(b.data.level) ||
    a.data.prerequisites.length - b.data.prerequisites.length ||
    a.id.localeCompare(b.id),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="discovery-topics" data-discovery-topics>
  {topics.map((topic) => {
    const composition = topicCompositions[topic.id];
    const found = lessons.filter((l) => l.data.topic === topic.id);
    if (!found.length) return null;
    const href =
      found.length === 1
        ? `${base}/learn/${found[0].id}/`
        : `${base}/topics/${topic.id}/`;
    return (
      <article
        class="discovery-topic image-card"
        data-discovery-topic={topic.id}
        data-topic-url={`${base}/topics/${topic.id}/`}
      >
        <div class="topic-visual" data-topic-visual>
          <CardArt
            art={composition.art}
            sizes="(max-width:760px) 100vw,(max-width:1100px) 50vw,33vw"
          />
        </div>
        <div class="topic-copy card-copy">
          <div class="topic-heading">
            <div>
              <p class="topic-count">
                <span data-topic-count>{found.length}</span>教材
              </p>
              <Heading>
                <a data-topic-destination href={href}>
                  {topic.title} <span aria-hidden="true">↗</span>
                </a>
              </Heading>
            </div>
          </div>
          <p class="topic-benefit">{topic.summary}</p>
          <ul class="topic-examples">
            {found.map((l, i) => (
              <li
                hidden={i > 1}
                data-topic-example
                data-id={l.id}
                data-level={l.data.level}
                data-search={[
                  l.data.title,
                  l.data.summary,
                  l.data.prerequisiteNote,
                  ...l.data.keywords,
                ].join(" ")}
              >
                <a href={`${base}/learn/${l.id}/`}>
                  {l.data.shortTitle ?? l.data.title}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    );
  })}
</div>
<style>
  .discovery-topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .discovery-topic {
    min-width: 0;
    background: var(--color-paper-light);
    display: flex;
    flex-direction: column;
  }
  .topic-heading {
    min-width: 0;
  }
  .topic-count {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-orange-ink);
  }
  h2,
  h3 {
    font-size: 24px;
    line-height: 1.6;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  h2 a,
  h3 a {
    display: block;
    min-height: 44px;
    padding-block: 4px;
    text-decoration: none;
  }
  h2 a:hover,
  h3 a:hover {
    text-decoration: underline;
  }
  h2 span,
  h3 span {
    font-size: inherit;
    color: var(--color-orange-ink);
  }
  .topic-benefit {
    text-wrap: balance;
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.6;
  }
  .topic-examples {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    min-width: 0;
  }
  .topic-examples a {
    text-wrap: balance;
    display: block;
    min-height: 44px;
    padding-block: 12px;
    text-decoration: none;
  }
  .topic-examples a:hover {
    text-decoration: underline;
  }
  .topic-examples span {
    color: var(--color-orange-ink);
  }
  .discovery-topics :global([hidden]) {
    display: none !important;
  }
  @media (max-width: 1100px) {
    .discovery-topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .discovery-topics {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
