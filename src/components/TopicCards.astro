---
import { getCollection } from "astro:content";
import { topics, levels } from "../data/catalog";
import CardArt from "./CardArt.astro";
import { topicCompositions } from "../data/card-art";
interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel: Heading = "h2" } = Astro.props;
const lessons = (await getCollection("lessons")).sort(
  (a, b) =>
    levels.indexOf(a.data.level) - levels.indexOf(b.data.level) ||
    a.data.prerequisites.length - b.data.prerequisites.length ||
    a.id.localeCompare(b.id),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="discovery-topics" data-discovery-topics>
  {topics.map((topic) => {
    const composition = topicCompositions[topic.id];
    const found = lessons.filter((l) => l.data.topic === topic.id);
    if (!found.length) return null;
    const href =
      found.length === 1
        ? `${base}/learn/${found[0].id}/`
        : `${base}/topics/${topic.id}/`;
    return (
      <article
        class:list={["discovery-topic", `composition--${composition.layout}`]}
        data-discovery-topic={topic.id}
        data-topic-url={`${base}/topics/${topic.id}/`}
      >
        <div class="topic-visual" data-topic-visual>
          <CardArt
            art={composition.art}
            sizes="(max-width:760px) 100vw,(max-width:1100px) 50vw,33vw"
          />
          {"cues" in composition && (
            <ul class="topic-visual-cues" aria-hidden="true">
              {composition.cues.map((cue) => (
                <li>{cue}</li>
              ))}
            </ul>
          )}
        </div>
        <div class="topic-copy">
          <div class="topic-heading">
            <div>
              <p class="topic-count">
                <span data-topic-count>{found.length}</span>教材
              </p>
              <Heading>
                <a data-topic-destination href={href}>
                  {topic.title} <span aria-hidden="true">↗</span>
                </a>
              </Heading>
            </div>
          </div>
          <p class="topic-benefit">{topic.summary}</p>
          <ul class="topic-examples">
            {found.map((l, i) => (
              <li
                hidden={i > 1}
                data-topic-example
                data-id={l.id}
                data-level={l.data.level}
                data-search={[
                  l.data.title,
                  l.data.summary,
                  l.data.prerequisiteNote,
                  ...l.data.keywords,
                ].join(" ")}
              >
                <a href={`${base}/learn/${l.id}/`}>
                  {l.data.shortTitle ?? l.data.title}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    );
  })}
</div>
<style>
  .discovery-topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .discovery-topic {
    min-width: 0;
    background: var(--color-paper-light);
    display: flex;
    flex-direction: column;
  }
  .topic-visual {
    display: grid;
    grid-template-columns: 1fr;
    aspect-ratio: 3 / 2;
    max-height: 224px;
    padding: 12px 16px 0;
    min-width: 0;
  }
  .topic-visual > :global(.card-art) {
    min-height: 0;
  }
  .topic-visual :global(img) {
    object-fit: contain;
    object-position: center;
  }
  .topic-copy {
    padding: 16px 24px 24px;
    min-width: 0;
  }
  .topic-heading {
    min-width: 0;
  }
  .topic-count {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-orange-ink);
  }
  h2,
  h3 {
    font-size: 24px;
    line-height: 1.6;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  h2 a,
  h3 a {
    display: block;
    min-height: 44px;
    padding-block: 4px;
    text-decoration: none;
  }
  h2 a:hover,
  h3 a:hover {
    text-decoration: underline;
  }
  h2 span,
  h3 span {
    font-size: inherit;
    color: var(--color-orange-ink);
  }
  .topic-benefit {
    text-wrap: balance;
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.6;
  }
  .topic-examples {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    min-width: 0;
  }
  .topic-examples a {
    text-wrap: balance;
    display: block;
    min-height: 44px;
    padding-block: 12px;
    text-decoration: none;
  }
  .topic-examples a:hover {
    text-decoration: underline;
  }
  .topic-examples span {
    color: var(--color-orange-ink);
  }
  .topic-visual:has(.topic-visual-cues) {
    aspect-ratio: auto;
    max-height: none;
    min-height: 224px;
  }
  .topic-visual:has(.topic-visual-cues) > :global(.card-art) {
    height: 192px;
    align-self: center;
  }
  .topic-visual-cues {
    list-style: none;
    padding: 0;
    margin: 0;
    align-self: center;
    display: grid;
    gap: 12px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .topic-visual-cues li {
    background: var(--color-paper);
    padding: 8px 12px;
  }
  .composition--map .topic-visual,
  .composition--inspect .topic-visual {
    grid-template-columns: 56% 44%;
  }
  .composition--map :global(.card-art),
  .composition--inspect :global(.card-art) {
    padding: 16px 8px 16px 0;
  }
  .composition--boundary .topic-visual,
  .composition--desk .topic-visual {
    grid-template-columns: 52% 48%;
  }
  .composition--boundary :global(.card-art),
  .composition--desk :global(.card-art) {
    order: 2;
    padding: 16px 0 16px 8px;
  }
  .discovery-topics :global([hidden]) {
    display: none !important;
  }
  @media (max-width: 1100px) {
    .discovery-topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .discovery-topics {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .topic-copy {
      padding: 16px;
    }
  }
</style>
