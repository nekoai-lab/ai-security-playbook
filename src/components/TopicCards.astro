---
import { getCollection } from "astro:content";
import { topics, levels } from "../data/catalog";
import CardArt from "./CardArt.astro";
import { topicCompositions } from "../data/card-art";
interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel: Heading = "h2" } = Astro.props;
const lessons = (await getCollection("lessons")).sort(
  (a, b) =>
    levels.indexOf(a.data.level) - levels.indexOf(b.data.level) ||
    a.data.prerequisites.length - b.data.prerequisites.length ||
    a.id.localeCompare(b.id),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="discovery-topics" data-discovery-topics>
  {topics.map((topic) => {
    const found = lessons.filter((l) => l.data.topic === topic.id);
    if (!found.length) return null;
    const href =
      found.length === 1
        ? `${base}/learn/${found[0].id}/`
        : `${base}/topics/${topic.id}/`;
    return (
      <article
        class:list={[
          "discovery-topic",
          `composition--${topicCompositions[topic.id].layout}`,
        ]}
        data-discovery-topic={topic.id}
        data-topic-url={`${base}/topics/${topic.id}/`}
      >
        <CardArt
          art={topicCompositions[topic.id].art}
          sizes="(max-width:760px) 160px,240px"
        />
        <div class="topic-copy">
          <div class="topic-heading">
            <div>
              <p class="topic-count">
                <span data-topic-count>{found.length}</span>教材
              </p>
              <Heading>
                <a data-topic-destination href={href}>
                  {topic.title} <span aria-hidden="true">↗</span>
                </a>
              </Heading>
            </div>
          </div>
          <p class="topic-benefit">{topic.summary}</p>
          <ul class="topic-examples">
            {found.map((l, i) => (
              <li
                hidden={i > 1}
                data-topic-example
                data-id={l.id}
                data-level={l.data.level}
                data-search={[
                  l.data.title,
                  l.data.summary,
                  l.data.prerequisiteNote,
                  ...l.data.keywords,
                ].join(" ")}
              >
                <a href={`${base}/learn/${l.id}/`}>
                  {l.data.shortTitle ?? l.data.title}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    );
  })}
</div>
<style>
  .discovery-topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .discovery-topic {
    min-width: 0;
    position: relative;
    overflow: hidden;
    background: var(--color-paper-light);
    display: flex;
    flex-direction: column;
  }
  .topic-copy {
    padding: 24px;
    min-width: 0;
  }
  .topic-heading {
    min-width: 0;
  }
  .topic-count {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-orange-ink);
  }
  h2,
  h3 {
    font-size: 24px;
    line-height: 1.6;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  h2 a,
  h3 a {
    display: block;
    min-height: 44px;
    padding-block: 4px;
    text-decoration: none;
  }
  h2 a:hover,
  h3 a:hover {
    text-decoration: underline;
  }
  h2 span,
  h3 span {
    font-size: inherit;
    color: var(--color-orange-ink);
  }
  .topic-benefit {
    text-wrap: balance;
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.6;
  }
  .topic-examples {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    min-width: 0;
  }
  .topic-examples a {
    text-wrap: balance;
    display: block;
    min-height: 44px;
    padding-block: 12px;
    text-decoration: none;
  }
  .topic-examples a:hover {
    text-decoration: underline;
  }
  .topic-examples span {
    color: var(--color-orange-ink);
  }
  .discovery-topic > :global(.card-art) {
    flex-shrink: 0;
  }
  .composition--scene-side {
    display: grid;
    grid-template-columns: 58% 42%;
  }
  .composition--scene-side > :global(.card-art) {
    grid-column: 2;
    grid-row: 1;
    height: 100%;
  }
  .composition--scene-side > .topic-copy {
    grid-column: 1;
    grid-row: 1;
    padding-right: 16px;
  }
  .composition--scene-bottom > :global(.card-art) {
    height: 112px;
    order: 2;
  }
  .composition--scene-bottom .topic-copy {
    padding-bottom: 12px;
  }
  .composition--walk {
    display: grid;
    grid-template-columns: 32% 68%;
  }
  .composition--walk > :global(.card-art) {
    align-self: center;
    height: 224px;
  }
  .composition--walk > .topic-copy {
    padding-left: 12px;
  }
  .composition--peek > :global(.card-art) {
    position: absolute;
    right: 0;
    top: 16px;
    width: 144px;
    height: 176px;
  }
  .composition--peek h2,
  .composition--peek h3,
  .composition--peek .topic-count {
    margin-right: 128px;
  }
  .composition--peek .topic-benefit {
    text-wrap: balance;
    padding-right: 128px;
  }
  .composition--desk > :global(.card-art) {
    height: 128px;
    width: 176px;
    position: absolute;
    bottom: 24px;
    left: 16px;
  }
  .composition--desk .topic-examples {
    margin-left: 160px;
    min-height: 112px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .discovery-topics :global([hidden]) {
    display: none !important;
  }
  @media (max-width: 760px) {
    .discovery-topics {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .topic-copy {
      padding: 16px;
    }
    .composition--scene-side {
      grid-template-columns: 62% 38%;
    }
    .composition--walk {
      grid-template-columns: 28% 72%;
    }
    .composition--walk > :global(.card-art) {
      height: 160px;
    }
    .composition--walk > .topic-copy {
      padding-left: 8px;
    }
    .composition--peek > :global(.card-art) {
      width: 104px;
      height: 144px;
      top: 16px;
    }
    .composition--peek h2,
    .composition--peek h3,
    .composition--peek .topic-count {
      margin-right: 88px;
    }
    .composition--peek .topic-benefit {
      text-wrap: balance;
      padding-right: 88px;
    }
    .composition--scene-bottom > :global(.card-art) {
      height: 112px;
    }
    .composition--desk > :global(.card-art) {
      width: 112px;
      height: 96px;
    }
    .composition--desk .topic-examples {
      margin-left: 96px;
    }
  }
</style>
