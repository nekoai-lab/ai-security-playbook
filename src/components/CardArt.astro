---
import CatPose from "./CatPose.astro";
import LessonArt from "./LessonArt.astro";
import type { CardArt } from "../data/card-art";
interface Props {
  art: CardArt;
  sizes?: string;
}
const { art, sizes = "(max-width:760px) 160px,240px" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div
  class:list={["card-art", `card-art--${art.kind}`]}
  data-card-art={
    art.kind === "pose"
      ? art.pose
      : art.kind === "scene"
        ? art.lesson
        : art.image
  }
  style={
    art.kind === "scene" ? `--card-art-position:${art.position}` : undefined
  }
  aria-hidden="true"
>
  {art.kind === "scene" ? (
    <LessonArt id={art.lesson} sizes={sizes} />
  ) : art.kind === "pose" ? (
    <CatPose pose={art.pose} />
  ) : (
    <img
      src={`${base}/images/${art.image}-480.webp`}
      srcset={`${base}/images/${art.image}-480.webp 480w, ${base}/images/${art.image}-960.webp 960w`}
      sizes={sizes}
      width="960"
      height="640"
      loading="lazy"
      decoding="async"
      alt=""
    />
  )}
</div>
<style>
  .card-art {
    min-width: 0;
    pointer-events: none;
    user-select: none;
  }
  .card-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    float: none;
  }
  .card-art--pose :global(img),
  .card-art--illustration :global(img) {
    object-fit: contain;
  }
  .card-art--scene :global(img) {
    object-fit: cover;
    object-position: var(--card-art-position, 50% 10%);
  }
</style>
