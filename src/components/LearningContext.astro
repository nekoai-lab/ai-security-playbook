---
import { getCollection } from "astro:content";
import { lessonVisuals, type LessonVisualId } from "../data/lesson-visuals";
import CatPose from "./CatPose.astro";
import CardArt from "./CardArt.astro";
import ArticleLabel from "./ArticleLabel.astro";
import { lessonCardArt, lessonCardSource } from "../data/card-art";
import illustrationCatalog from "../../design/assets/illustration-library/catalog.json";
import { seriesFor } from "../data/catalog";
import { learningPaths } from "../data/learning-paths";
interface Props {
  id: string;
}
const { id } = Astro.props;
const seriesGroup = seriesFor(id);
const pathGroup = learningPaths.find((p) => p.ids.includes(id));
const group =
  seriesGroup ??
  (pathGroup
    ? { id: pathGroup.id, title: pathGroup.label, ids: pathGroup.ids }
    : undefined);
const contextKind = seriesGroup ? "シリーズ" : "学習ルート";
const contextSection = seriesGroup ? "series" : "paths";
const routeSuffix = !seriesGroup && pathGroup ? `?route=${pathGroup.id}` : "";
const lessons = await getCollection("lessons");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const index = group?.ids.indexOf(id) ?? -1;
const current = lessons.find((l) => l.id === id)!;
const follow = current.data.related.find((key) => !group?.ids.includes(key));
const next = group?.ids[index + 1];
const target = next ?? follow;
const item = (key: string) => lessons.find((l) => l.id === key)!;
const title = (key: string) => item(key)?.data.title ?? key;
const visual = (key: string) => {
  const id = (key in lessonVisuals ? key : "basics") as LessonVisualId;
  const image = lessonCardSource(id)
    .replace("public/images/", "")
    .replace("-960.webp", "");
  const art = lessonCardArt(id);
  const asset = illustrationCatalog.assets.find((a) => a.id === image);
  if (!asset) throw new Error(`Missing next-card asset: ${image}`);
  const delivery =
    "deliveries" in asset
      ? asset.deliveries?.find((d) => d.width === 960)
      : undefined;
  return {
    image,
    artKey: art.kind === "illustration" ? art.image : id,
    width: 960,
    height: delivery?.height ?? Math.round((960 * asset.height) / asset.width),
  };
};
const catalog = Object.fromEntries(
  lessons.map((l) => [
    l.id,
    { title: l.data.title, summary: l.data.summary, ...visual(l.id) },
  ]),
);
---

{group && (
  <section
    class="learning-context"
    data-learning-context
    data-lesson-id={id}
    data-base={base}
    data-paths={JSON.stringify(
      learningPaths.map((p) => ({ id: p.id, label: p.label, ids: p.ids })),
    )}
    data-items={JSON.stringify(catalog)}
    data-follow={JSON.stringify(current.data.related)}
  >
    <p class="context-state" data-context-state>
      {next
        ? "続けて読む"
        : seriesGroup
          ? "このシリーズはここまで"
          : "このルートはここまで"}
    </p>
    <p class="catalog-meta" data-context-label>
      {contextKind} · 全{group.ids.length}記事のうち{index + 1}記事目
    </p>
    <a
      class="reading-next image-card"
      data-context-next
      href={
        target
          ? `${base}/learn/${target}/${next ? routeSuffix : ""}`
          : `${base}/library/`
      }
    >
      <CardArt
        art={lessonCardArt((target ?? id) as LessonVisualId)}
        trackNext
        sizes="(max-width:760px) calc(100vw - 32px),640px"
      />
      <span class="reading-next-copy card-copy">
        <span data-next-label>
          {next ? "次に読む" : target ? "次のテーマへ" : "ほかの教材を探す"}
          <span aria-hidden="true"> →</span>
        </span>
        <strong data-next-title>
          <ArticleLabel article={Boolean(target)}>
            <span data-next-title-text>
              {target ? title(target) : "別の教材を探す"}
            </span>
          </ArticleLabel>
        </strong>
        <span class="reading-next-reason" data-next-reason>
          {target
            ? item(target).data.summary
            : "テーマや検索から、次に確かめたいことを選べます。"}
        </span>
      </span>
    </a>
    <details>
      <summary class="reading-route-end">
        読む順番・ルートを見る
        {[
          "commands",
          "mcp-permissions",
          "launch-checklist",
          "incident-response",
        ].includes(id) && <CatPose pose="tail" />}
      </summary>
      <a
        class="context-title"
        data-context-title
        href={`${base}/${contextSection}/${group.id}/`}
      >
        {group.title}
      </a>
      <ol data-context-list>
        {group.ids.map((key) => (
          <li>
            <a
              href={`${base}/learn/${key}/${routeSuffix}`}
              aria-current={key === id ? "page" : undefined}
            >
              {title(key)}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </section>
)}
<script>
  const context = document.querySelector<HTMLElement>(
    "[data-learning-context]",
  );
  if (context) {
    const routes = JSON.parse(context.dataset.paths ?? "[]") as {
      id: string;
      label: string;
      ids: string[];
    }[];
    const id = context.dataset.lessonId!;
    const route = routes.find(
      (p) =>
        p.id === new URL(location.href).searchParams.get("route") &&
        p.ids.includes(id),
    );
    if (route) {
      const base = context.dataset.base!;
      const items = JSON.parse(context.dataset.items ?? "{}") as Record<
        string,
        {
          title: string;
          summary: string;
          image: string;
          width: number;
          height: number;
          artKey: string;
        }
      >;
      const follow = JSON.parse(context.dataset.follow ?? "[]") as string[];
      const index = route.ids.indexOf(id),
        next = route.ids[index + 1];
      const target = next ?? follow.find((key) => !route.ids.includes(key));
      context.querySelector("[data-context-state]")!.textContent = next
        ? "続けて読む"
        : "このルートはここまで";
      context.querySelector("[data-context-label]")!.textContent =
        `学習ルート · 全${route.ids.length}記事のうち${index + 1}記事目`;
      const overview = context.querySelector<HTMLAnchorElement>(
        "[data-context-title]",
      )!;
      overview.textContent = route.label;
      overview.href = `${base}/paths/${route.id}/`;
      const list = context.querySelector("[data-context-list]")!;
      list.replaceChildren();
      for (const key of route.ids) {
        const li = document.createElement("li"),
          a = document.createElement("a");
        a.href = `${base}/learn/${key}/?route=${route.id}`;
        a.textContent = items[key].title;
        if (key === id) a.setAttribute("aria-current", "page");
        li.append(a);
        list.append(li);
      }
      const link = context.querySelector<HTMLAnchorElement>(
        "[data-context-next]",
      )!;
      link.href = next
        ? `${base}/learn/${next}/?route=${route.id}`
        : target
          ? `${base}/learn/${target}/`
          : `${base}/library/`;
      context.querySelector("[data-next-label]")!.textContent = next
        ? "次に読む →"
        : target
          ? "次のテーマへ →"
          : "ほかの教材を探す →";
      context.querySelector("[data-next-title-text]")!.textContent = target
        ? items[target].title
        : "別の教材を探す";
      const titleLabel = context.querySelector<HTMLElement>(
        "[data-next-title] [data-article-label]",
      )!;
      titleLabel.classList.toggle("article-label--plain", !target);
      titleLabel.querySelector<HTMLImageElement>("img")!.hidden = !target;
      const art = context.querySelector<HTMLImageElement>("[data-next-art]")!;
      art.width = items[target ?? id].width;
      art.height = items[target ?? id].height;
      context.querySelector<HTMLElement>("[data-next-media]")!.dataset.cardArt =
        items[target ?? id].artKey;
      const image = items[target ?? id].image;
      art.srcset = `${base}/images/${image}-480.webp 480w, ${base}/images/${image}-960.webp 960w`;
      art.src = `${base}/images/${image}-480.webp`;
      context.querySelector("[data-next-reason]")!.textContent = target
        ? items[target].summary
        : "テーマや検索から、次に確かめたいことを選べます。";
    }
  }
</script>
