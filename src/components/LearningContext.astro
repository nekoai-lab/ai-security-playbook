---
import { getCollection } from "astro:content";
import { lessonVisuals, type LessonVisualId } from "../data/lesson-visuals";
import CatPose from "./CatPose.astro";
import { seriesFor } from "../data/catalog";
import { learningPaths } from "../data/learning-paths";
interface Props {
  id: string;
}
const { id } = Astro.props;
const group = seriesFor(id);
const lessons = await getCollection("lessons");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const index = group?.ids.indexOf(id) ?? -1;
const current = lessons.find((l) => l.id === id)!;
const follow = current.data.related.find((key) => !group?.ids.includes(key));
const next = group?.ids[index + 1];
const target = next ?? follow;
const item = (key: string) => lessons.find((l) => l.id === key)!;
const title = (key: string) => item(key)?.data.title ?? key;
const visual = (key: string) =>
  lessonVisuals[key as LessonVisualId] ?? lessonVisuals.basics;
const art = visual(target ?? id);
const catalog = Object.fromEntries(
  lessons.map((l) => [
    l.id,
    { title: l.data.title, summary: l.data.summary, image: visual(l.id).image },
  ]),
);
---

{group && (
  <section
    class="learning-context"
    data-learning-context
    data-lesson-id={id}
    data-base={base}
    data-paths={JSON.stringify(
      learningPaths.map((p) => ({ id: p.id, label: p.label, ids: p.ids })),
    )}
    data-items={JSON.stringify(catalog)}
    data-follow={JSON.stringify(current.data.related)}
  >
    <p class="context-state" data-context-state>
      {next ? "続けて読む" : "このシリーズはここまで"}
    </p>
    <p class="catalog-meta" data-context-label>
      シリーズ · 全{group.ids.length}記事のうち{index + 1}記事目
    </p>
    <a
      class="reading-next"
      data-context-next
      href={target ? `${base}/learn/${target}/` : `${base}/library/`}
    >
      <img
        class="reading-next-art"
        data-next-art
        src={`${base}/images/${art.image}-480.webp`}
        srcset={`${base}/images/${art.image}-480.webp 480w, ${base}/images/${art.image}-960.webp 960w`}
        sizes="(max-width: 760px) 192px, 160px"
        width="960"
        height="640"
        loading="lazy"
        decoding="async"
        alt=""
      />
      <span class="reading-next-copy">
        <span data-next-label>
          {next ? "次に読む" : target ? "次のテーマへ" : "ほかの教材を探す"}
          <span aria-hidden="true"> →</span>
        </span>
        <strong data-next-title>
          {target ? title(target) : "別の教材を探す"}
        </strong>
        <span class="reading-next-reason" data-next-reason>
          {target
            ? item(target).data.summary
            : "テーマや検索から、次に確かめたいことを選べます。"}
        </span>
      </span>
    </a>
    <details>
      <summary class="reading-route-end">
        読む順番・ルートを見る
        {[
          "commands",
          "mcp-permissions",
          "launch-checklist",
          "incident-response",
        ].includes(id) && <CatPose pose="tail" />}
      </summary>
      <a
        class="context-title"
        data-context-title
        href={`${base}/series/${group.id}/`}
      >
        {group.title}
      </a>
      <ol data-context-list>
        {group.ids.map((key) => (
          <li>
            <a
              href={`${base}/learn/${key}/`}
              aria-current={key === id ? "page" : undefined}
            >
              {title(key)}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </section>
)}
<script>
  const context = document.querySelector<HTMLElement>(
    "[data-learning-context]",
  );
  if (context) {
    const routes = JSON.parse(context.dataset.paths ?? "[]") as {
      id: string;
      label: string;
      ids: string[];
    }[];
    const id = context.dataset.lessonId!;
    const route = routes.find(
      (p) =>
        p.id === new URL(location.href).searchParams.get("route") &&
        p.ids.includes(id),
    );
    if (route) {
      const base = context.dataset.base!;
      const items = JSON.parse(context.dataset.items ?? "{}") as Record<
        string,
        { title: string; summary: string; image: string }
      >;
      const follow = JSON.parse(context.dataset.follow ?? "[]") as string[];
      const index = route.ids.indexOf(id),
        next = route.ids[index + 1];
      const target = next ?? follow.find((key) => !route.ids.includes(key));
      context.querySelector("[data-context-state]")!.textContent = next
        ? "続けて読む"
        : "このルートはここまで";
      context.querySelector("[data-context-label]")!.textContent =
        `学習ルート · 全${route.ids.length}記事のうち${index + 1}記事目`;
      const overview = context.querySelector<HTMLAnchorElement>(
        "[data-context-title]",
      )!;
      overview.textContent = route.label;
      overview.href = `${base}/paths/${route.id}/`;
      const list = context.querySelector("[data-context-list]")!;
      list.replaceChildren();
      for (const key of route.ids) {
        const li = document.createElement("li"),
          a = document.createElement("a");
        a.href = `${base}/learn/${key}/?route=${route.id}`;
        a.textContent = items[key].title;
        if (key === id) a.setAttribute("aria-current", "page");
        li.append(a);
        list.append(li);
      }
      const link = context.querySelector<HTMLAnchorElement>(
        "[data-context-next]",
      )!;
      link.href = next
        ? `${base}/learn/${next}/?route=${route.id}`
        : target
          ? `${base}/learn/${target}/`
          : `${base}/library/`;
      context.querySelector("[data-next-label]")!.textContent = next
        ? "次に読む →"
        : target
          ? "次のテーマへ →"
          : "ほかの教材を探す →";
      context.querySelector("[data-next-title]")!.textContent = target
        ? items[target].title
        : "別の教材を探す";
      const art = context.querySelector<HTMLImageElement>("[data-next-art]")!;
      const image = items[target ?? id].image;
      art.srcset = `${base}/images/${image}-480.webp 480w, ${base}/images/${image}-960.webp 960w`;
      art.src = `${base}/images/${image}-480.webp`;
      context.querySelector("[data-next-reason]")!.textContent = target
        ? items[target].summary
        : "テーマや検索から、次に確かめたいことを選べます。";
    }
  }
</script>
