---
import { getEntry } from "astro:content";
import LessonArt from "./LessonArt.astro";
import type { FeaturedLesson } from "../data/featured-lessons";
interface Props {
  lesson: FeaturedLesson;
  compact?: boolean;
  stack?: boolean;
}
const { lesson, compact = false, stack = false } = Astro.props;
const entry = await getEntry("lessons", lesson.id);
if (!entry) throw new Error(`Missing featured lesson: ${lesson.id}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a
  class:list={[
    "featured-lesson",
    { "featured-lesson--compact": compact, "featured-lesson--stack": stack },
  ]}
  data-featured-lesson={lesson.id}
  href={`${base}/learn/${lesson.id}/`}
>
  <LessonArt
    id={lesson.id}
    sizes={
      compact
        ? "80px"
        : "(max-width:760px) calc(100vw - 64px), (max-width:1100px) 42vw,240px"
    }
  />
  <div class="featured-lesson-copy">
    <p class="situation">{lesson.situation}</p>
    <h3>{lesson.question}</h3>
    <p class="takeaway">{lesson.takeaway}</p>
    <p class="readiness">
      <strong>{entry.data.level}</strong> · {entry.data.prerequisiteNote}
    </p>
    <p class="metadata">
      約{entry.data.minutes}分 ·{" "}
      <time datetime={entry.data.updated}>
        {entry.data.updated.replaceAll("-", ".")} 更新
      </time>
    </p>
    <span class="action">
      教材を読む <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
<style>
  .featured-lesson {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    align-items: start;
    padding: 24px;
    min-width: 0;
    background: var(--color-paper-light);
    color: var(--color-ink);
    text-decoration: none;
  }
  .featured-lesson:hover {
    background: var(--color-orange-soft);
  }
  .featured-lesson:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }
  .featured-lesson-copy {
    min-width: 0;
  }
  p,
  h3 {
    margin: 0 0 12px;
  }
  .situation {
    color: var(--color-orange-ink);
    font-size: 12px;
    line-height: 1.6;
  }
  h3 {
    font-size: 24px;
    line-height: 1.6;
    text-wrap: balance;
  }
  .takeaway {
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  .metadata,
  .readiness {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: balance;
  }
  .readiness strong {
    color: var(--color-ink);
  }
  .action {
    display: block;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-orange-ink);
  }
  .featured-lesson--compact {
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 16px;
    padding: 16px;
  }
  .featured-lesson--compact h3 {
    font-size: 16px;
  }
  .featured-lesson--compact .situation,
  .featured-lesson--compact .action {
    display: none;
  }
  @media (max-width: 1100px) {
    .featured-lesson:not(.featured-lesson--compact) {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .featured-lesson:not(.featured-lesson--compact) {
      padding: 16px;
      gap: 16px;
    }
  }
</style>

<style>
  .readiness {
    font-size: 16px;
    line-height: 1.9;
  }
  .featured-lesson--compact {
    gap: 8px 16px;
  }
  .featured-lesson--compact .featured-lesson-copy {
    display: contents;
  }
  .featured-lesson--compact :global(.lesson-art) {
    grid-column: 1;
    grid-row: 1;
  }
  .featured-lesson--compact h3 {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    align-self: center;
  }
  .featured-lesson--compact .takeaway,
  .featured-lesson--compact .readiness,
  .featured-lesson--compact .metadata {
    grid-column: 1 / -1;
    margin: 0;
  }
</style>

<style>
  .featured-lesson--stack {
    grid-template-columns: 1fr;
    height: 100%;
  }
</style>
