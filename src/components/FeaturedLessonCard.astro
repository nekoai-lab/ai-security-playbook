---
import ArticleLabel from "./ArticleLabel.astro";
import { getEntry } from "astro:content";
import CardArt from "./CardArt.astro";
import { lessonCardArt } from "../data/card-art";
import type { FeaturedLesson } from "../data/featured-lessons";
interface Props {
  lesson: FeaturedLesson;
  compact?: boolean;
  stack?: boolean;
}
const { lesson, compact = false, stack = false } = Astro.props;
const entry = await getEntry("lessons", lesson.id);
if (!entry) throw new Error(`Missing featured lesson: ${lesson.id}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const art = lessonCardArt(lesson.id);
---

<a
  class:list={[
    "featured-lesson image-card",
    { "featured-lesson--compact": compact, "featured-lesson--stack": stack },
  ]}
  data-featured-lesson={lesson.id}
  href={`${base}/learn/${lesson.id}/`}
>
  <CardArt
    art={art}
    sizes="(max-width:760px) calc(100vw - 32px), (max-width:1100px) 50vw,33vw"
  />
  <div class="featured-lesson-copy card-copy">
    <p class="situation">{lesson.situation}</p>
    <h3>
      <ArticleLabel>{lesson.question}</ArticleLabel>
    </h3>
    <p class="takeaway">{lesson.takeaway}</p>
    <p class="readiness">
      <strong>{entry.data.level}</strong> · {entry.data.prerequisiteNote}
    </p>
    <p class="metadata">
      約{entry.data.minutes}分 ·{" "}
      <time datetime={entry.data.updated}>
        {entry.data.updated.replaceAll("-", ".")} 更新
      </time>
    </p>
    <span class="action">
      教材を読む <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
<style>
  .featured-lesson {
    color: var(--color-ink);
    text-decoration: none;
    height: 100%;
  }
  .featured-lesson:hover {
    background: var(--color-orange-soft);
  }
  .featured-lesson:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }
  .featured-lesson-copy {
    min-width: 0;
  }
  p,
  h3 {
    margin: 0 0 12px;
  }
  .situation {
    color: var(--color-orange-ink);
    font-size: 12px;
    line-height: 1.6;
  }
  h3 {
    font-size: 24px;
    line-height: 1.6;
    text-wrap: balance;
  }
  .takeaway {
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  .metadata,
  .readiness {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: balance;
  }
  .readiness {
    font-size: 16px;
    line-height: 1.9;
  }
  .readiness strong {
    color: var(--color-ink);
  }
  .action {
    display: block;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-orange-ink);
  }
</style>
