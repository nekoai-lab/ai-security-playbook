---
interface Props {
  kind?: "book" | "terminal" | "layers" | "compass" | "cat";
  class?: string;
}
const { kind = "compass", class: className = "" } = Astro.props;
---

<svg
  class:list={["field-icon", className]}
  viewBox="0 0 160 112"
  fill="none"
  aria-hidden="true"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {kind === "book" ? (
    <>
      <path d="M14 27Q48 13 78 33Q110 14 145 26L138 91Q106 79 79 97Q50 80 20 91Z" />
      <path d="M78 33L79 97M20 33Q49 23 71 37L72 85Q46 74 25 82ZM86 38Q110 23 138 32L132 81Q110 76 87 88Z" />
      <path
        d="m30 42 30 3m-31 7 33 3m-32 6 32 4m-30 5 25 4m38-28 30-6m-30 15 31-6m-30 15 28-6m-28 15 24-5"
        opacity=".55"
      />
      <path d="M8 96q38-7 70 8 34-15 68-8" />
      <path
        d="m111 24 2-12 8 3-3 11"
        stroke="var(--color-orange)"
        stroke-width="3"
      />
    </>
  ) : kind === "terminal" ? (
    <>
      <path d="m30 15 102 9-5 62-98-8ZM36 22l89 8-4 48-86-8Z" />
      <path d="m30 78-20 19 114 11 24-18-21-4M10 97v5l113 10 25-17v-5M45 89l60 6m-54-2 45 4M66 87l30 3" />
      <path
        d="m47 39 11 9-12 7m23 5 22 2"
        stroke="var(--color-orange)"
        stroke-width="3"
      />
      <path d="M137 17v37m-5-22h10m-11 7h10" opacity=".5" />
    </>
  ) : kind === "layers" ? (
    <>
      <path d="m20 33 62-25 60 25-62 28ZM20 50l60 28 62-28M20 68l60 28 62-28M20 33v8m122-8v8M20 50v10m122-10v10M20 68v10l60 28 62-28V68" />
      <path d="m51 33 31-12 29 12-31 13ZM80 61v17m0 18v10m-44-54 10 5m68-5 10-4" />
      <path
        d="M80 28v10m-5-5h10"
        stroke="var(--color-orange)"
        stroke-width="3"
      />
    </>
  ) : kind === "cat" ? (
    <>
      <path
        d="M45 41 43 13l24 15q17-6 31 0l23-15-1 31q12 12 10 29-2 28-46 28S40 90 38 73q-2-20 7-32Z"
        fill="var(--color-ink)"
      />
      <path
        d="M85 34v59q38-1 37-24-1-19-17-21l-7-19Z"
        fill="var(--color-paper)"
        stroke="none"
      />
      <path d="M70 60h1m32 0h1" stroke="var(--color-orange)" stroke-width="9" />
      <path
        d="m82 72 5 0-3 4ZM55 76l-20-3m20 9-20 3m74-9 23-3m-23 9 22 3"
        stroke="var(--color-paper)"
      />
      <path
        d="M83 77v7m0-1q-8 6-13 0m13 0q8 6 13 0"
        stroke="var(--color-paper)"
      />
    </>
  ) : (
    <>
      <circle cx="80" cy="56" r="35" />
      <circle cx="80" cy="56" r="27" stroke-dasharray="1 6" />
      <path d="M80 9v20m0 54v20M33 56h21m51 0h22m-69 22 44-44-14 30Z" />
      <path
        d="m102 34-22 22 8 8Z"
        fill="var(--color-orange)"
        stroke="var(--color-orange)"
      />
    </>
  )}
</svg>
