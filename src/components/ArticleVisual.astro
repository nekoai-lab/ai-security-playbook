---
import ReadingArt from "./ReadingArt.astro";
import FieldIcon from "./FieldIcon.astro";
interface Props {
  kind:
    | "scene"
    | "types"
    | "build"
    | "boundary"
    | "inspect"
    | "browser-secret"
    | "limits"
    | "rotation"
    | "node-update";
}
const { kind } = Astro.props;
const captions = {
  scene:
    "ブラウザとサーバー、どこで使う？ 挿絵は迷う場面のイメージです。秘密の置き方は、この後の図で確かめます。",
  "browser-secret":
    "画面に表示しなくても、ブラウザへ送るプログラムや通信に含めた値は調べられます。架空の表示例です。",
  limits:
    "キーを隠すことと、代理する窓口の利用を制限することは別の確認です。これは対策の整理で、安全性の保証ではありません。",
  rotation:
    "消すだけで終わらせず、旧キーの失効・切り替え・利用履歴の調査を進めます。稼働中の処理への影響は提供元の手順で確認します。",
  "node-update":
    "歯車は実行環境を表すイメージです。インストールした版と、起動中の処理が使う版を分けて確かめます。",
  types:
    "まず発行元の説明で用途を確認。APIキーという名前だけでは、公開してよいか決まりません。",
  build:
    ".envファイルを配らなくても、ブラウザ用コードへ参照した値が組み込まれる経路があります。Viteの標準設定の例です。",
  boundary:
    "秘密のキーはサーバーで使い、ブラウザへ返しません。外部サービスには、処理する文章も送られます。",
  inspect:
    "設定を確認する場所は3つ。一人で兼任していても、それぞれ別に見ます。画面は架空の説明用です。",
};
---

<figure
  class:list={["article-visual", `article-visual--${kind}`]}
  data-article-visual={kind}
>
  {kind === "scene" && (
    <div class="visual-scene">
      <ReadingArt id="api-keys" />
      <div>
        <p class="visual-kicker">こんなところで、迷っていませんか？</p>
        <p class="visual-speech">
          「APIキーを設定して」
          <br />
          と言われたけれど……
        </p>
        <p class="visual-detail">
          どこに書く？
          <br />
          公開するときも、このまま？
        </p>
      </div>
    </div>
  )}
  {kind === "types" && (
    <div class="visual-pair">
      <div class="visual-node">
        <FieldIcon kind="book" />
        <strong>公開を想定したキー</strong>
        <p>ブラウザでの使用を、提供元が認めている。</p>
        <p class="visual-detail">データへの権限設定は、別に必要。</p>
      </div>
      <div class="visual-node visual-node--accent">
        <FieldIcon kind="layers" />
        <strong>サーバー専用の秘密</strong>
        <p>利用者へ配るコードに含めず、管理する側で使う。</p>
        <p class="visual-detail">今回の要約アプリで扱うのはこちら。</p>
      </div>
    </div>
  )}
  {kind === "build" && (
    <div class="visual-stack">
      <div class="visual-node">
        <strong>開発するPCの .env</strong>
        <p class="visual-detail">VITE_SUMMARY_KEY</p>
        <p class="visual-value">DEMO_PUBLIC_12345</p>
      </div>
      <p class="visual-transfer">
        <span aria-hidden="true">↓</span> ビルド：公開用ファイルを作る
      </p>
      <div class="visual-node">
        <strong>公開用のJavaScript</strong>
        <p>参照した設定値がコードに入る。</p>
        <p class="visual-value">DEMO_PUBLIC_12345</p>
      </div>
      <p class="visual-transfer">
        <span aria-hidden="true">↓</span> ファイルを配信
      </p>
      <div class="visual-node">
        <strong>利用者のブラウザ</strong>
        <p>届いたコードの中身を調べられる。</p>
      </div>
    </div>
  )}
  {kind === "boundary" && (
    <div class="visual-stack">
      <div class="visual-node">
        <strong>利用者のブラウザ</strong>
        <p>秘密のキーは持たない。</p>
      </div>
      <div class="visual-exchange">
        <p>
          <span aria-hidden="true">↓</span> 文章
        </p>
        <p>
          <span aria-hidden="true">↑</span> 結果
        </p>
      </div>
      <div class="visual-node visual-node--accent">
        <strong>自分の管理するサーバー</strong>
        <p>誰が・どれだけ使えるかを確認。</p>
        <p class="visual-value">秘密のキーはここで使う</p>
        <p class="visual-detail">ブラウザへの応答には含めない。</p>
      </div>
      <div class="visual-exchange">
        <p>
          <span aria-hidden="true">↓</span> 文章＋キー
        </p>
        <p>
          <span aria-hidden="true">↑</span> 結果
        </p>
      </div>
      <div class="visual-node">
        <strong>外部の要約サービス</strong>
        <p>文章を処理して、結果を返す。</p>
      </div>
    </div>
  )}
  {kind === "inspect" && (
    <ol class="visual-inspect">
      <li>
        <FieldIcon kind="compass" />
        <div>
          <strong>発行元で、種類を見る</strong>
          <p class="visual-detail">
            キーの種類：サーバー専用
            <br />
            用途・権限を公式の説明と照合。
          </p>
        </div>
      </li>
      <li>
        <FieldIcon kind="terminal" />
        <div>
          <strong>コードで、実行場所を見る</strong>
          <p class="visual-detail">
            変数名：SUMMARY_API_KEY
            <br />
            値を出さず、参照ファイルを確認。
          </p>
        </div>
      </li>
      <li>
        <FieldIcon kind="layers" />
        <div>
          <strong>公開先で、渡る範囲を見る</strong>
          <p class="visual-detail">
            保存先：サーバー用の設定
            <br />
            配信物と通信も確認。
          </p>
        </div>
      </li>
    </ol>
  )}

  {kind === "browser-secret" && (
    <div class="visual-pair">
      <div class="visual-node">
        <FieldIcon kind="terminal" />
        <strong>画面で見えるもの</strong>
        <p>要約ボタンと、要約の結果。</p>
        <p class="visual-detail">キーの文字は表示していない。</p>
      </div>
      <div class="visual-node visual-node--accent">
        <FieldIcon kind="layers" />
        <strong>ブラウザに届くもの</strong>
        <p>ボタンを動かすコードと通信。</p>
        <p class="visual-value">中にキーがあれば、そこから読める。</p>
      </div>
    </div>
  )}
  {kind === "limits" && (
    <div class="visual-stack">
      <div class="visual-node">
        <strong>キーはサーバー側に置けた</strong>
        <p>利用者に秘密を渡さない。</p>
      </div>
      <p class="visual-transfer">↓ もう一つ確認する</p>
      <div class="visual-node visual-node--accent">
        <strong>この窓口を、誰が使える？</strong>
        <p>利用者の権限と、回数・文章量の制限。</p>
        <p class="visual-detail">
          無制限に代理すれば、他人の利用で料金が増えることも。
        </p>
      </div>
      <p class="visual-transfer">↓ 許可した範囲で処理する</p>
      <div class="visual-node">
        <strong>外部の要約サービスへ</strong>
        <p>送る文章の扱いも、別に確認。</p>
      </div>
    </div>
  )}
  {kind === "rotation" && (
    <ol class="visual-inspect">
      <li>
        <FieldIcon kind="compass" />
        <div>
          <strong>どのキーか特定する</strong>
          <p class="visual-detail">値を相談文へ貼らず、発行元と用途を確認。</p>
        </div>
      </li>
      <li>
        <FieldIcon kind="layers" />
        <div>
          <strong>旧キーの失効・交換</strong>
          <p class="visual-detail">
            切り替え先と停止の影響を、公式手順で確認。
          </p>
        </div>
      </li>
      <li>
        <FieldIcon kind="book" />
        <div>
          <strong>履歴と公開物を調べる</strong>
          <p class="visual-detail">
            不審な利用と、同じ漏えい経路が残らないかを確認。
          </p>
        </div>
      </li>
    </ol>
  )}
  {kind === "node-update" && (
    <div class="visual-node-scene">
      <ReadingArt id="node-october-2026" />
      <div class="visual-pair">
        <div class="visual-node">
          <strong>新しく起動するNode</strong>
          <p>導入先の版を確認する。</p>
          <p class="visual-detail">更新した実行ファイルを使うか確認。</p>
        </div>
        <div class="visual-node visual-node--accent">
          <strong>すでに動いている処理</strong>
          <p>その処理の実行版を確認する。</p>
          <p class="visual-detail">MCP・開発サーバー・本番を分ける。</p>
        </div>
      </div>
    </div>
  )}
  <figcaption>{captions[kind]}</figcaption>
</figure>
