---
interface Props {
  size?: number;
  class?: string;
}
const { size = 96, class: className = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<img
  class:list={["explorer-cat", className]}
  src={`${base}/brand/explorer-cat-256.webp`}
  srcset={`${base}/brand/explorer-cat-256.webp 256w, ${base}/brand/explorer-cat-512.webp 512w`}
  sizes={`${size}px`}
  width={size}
  height={size}
  loading="lazy"
  alt=""
/>
