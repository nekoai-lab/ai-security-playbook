---
import { readerJourneys } from "../data/reader-journeys";
import CatPose from "./CatPose.astro";
const poses = ["peek-side", "walk-right", "investigate"] as const;
const actions = [
  "入力する情報と、任せる操作を確かめる",
  "作り始めから公開までの教材を見る",
  "更新・監視・復旧の教材を見る",
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="reader-entries">
  {readerJourneys.map((journey, i) => (
    <article class="reader-entry" data-reader-entry={journey.id}>
      <div class="entry-title">
        <CatPose pose={poses[i]} />
        <h3>{journey.label}</h3>
      </div>
      <p>{journey.summary}</p>
      <a class="entry-action" href={`${base}/start/${journey.id}/`}>
        {actions[i]} →
      </a>
    </article>
  ))}
</div>
<style>
  .reader-entries {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .reader-entry {
    min-width: 0;
    padding: 24px;
    background: var(--color-paper-light);
  }
  .entry-title :global(.cat-pose) {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .entry-title {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.6;
    text-wrap: balance;
  }
  p {
    margin: 16px 0;
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  a {
    display: block;
    padding-block: 12px;
    min-height: 44px;
    font-size: 16px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .entry-action {
    text-wrap: balance;
    color: var(--color-orange-ink);
    font-weight: 700;
  }
  @media (max-width: 1000px) {
    .reader-entries {
      grid-template-columns: 1fr;
    }
    .reader-entry {
      padding: 16px;
    }
  }
</style>

<style>
  @media (max-width: 360px) {
    .entry-title {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .entry-title :global(img) {
      width: 80px;
    }
  }
</style>
