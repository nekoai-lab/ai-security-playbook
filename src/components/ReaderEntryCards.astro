---
import { readerJourneys } from "../data/reader-journeys";
import CardArt from "./CardArt.astro";
import { topicCompositions } from "../data/card-art";
const arts = [
  topicCompositions["ai-tools"].art,
  topicCompositions.development.art,
  topicCompositions.operations.art,
];
const actions = [
  "入力する情報と、任せる操作を確かめる",
  "作り始めから公開までの教材を見る",
  "更新・監視・復旧の教材を見る",
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="reader-entries">
  {readerJourneys.map((journey, i) => (
    <article class="reader-entry image-card" data-reader-entry={journey.id}>
      <CardArt art={arts[i]} sizes="(max-width:760px) 100vw,33vw" />
      <div class="card-copy">
        <div class="entry-title">
          <h3>{journey.label}</h3>
        </div>
        <p>{journey.summary}</p>
        <a class="entry-action" href={`${base}/start/${journey.id}/`}>
          {actions[i]} →
        </a>
      </div>
    </article>
  ))}
</div>
<style>
  .reader-entries {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.6;
    text-wrap: balance;
  }
  p {
    margin: 16px 0;
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  a {
    display: block;
    padding-block: 12px;
    min-height: 44px;
    font-size: 16px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .entry-action {
    text-wrap: balance;
    color: var(--color-orange-ink);
    font-weight: 700;
  }
  @media (max-width: 1100px) {
    .reader-entries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .reader-entries {
      grid-template-columns: 1fr;
    }
  }
</style>
