---
import Shell from "../../layouts/Shell.astro";
import LessonDiscovery from "../../components/LessonDiscovery.astro";
import LessonArt from "../../components/LessonArt.astro";
import { getCollection } from "astro:content";
import { topics } from "../../data/catalog";
import { type TopicGuideData, topicGuides } from "../../data/topic-guides";
export async function getStaticPaths() {
  const all = await getCollection("lessons");
  return topics
    .filter((t) => all.some((l) => l.data.topic === t.id))
    .map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}
const { topic } = Astro.props;
const guide: TopicGuideData = topicGuides[topic.id];
const lessons = (await getCollection("lessons")).filter(
  (l) => l.data.topic === topic.id,
);
if (!lessons.some((l) => l.id === guide.feature))
  throw new Error(`Missing featured lesson for ${topic.id}`);
const neighbors = guide.related.map((id) => topics.find((t) => t.id === id)!);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Shell title={topic.title} description={topic.summary}>
  <div class="wrap hub-page topic-guide">
    <nav class="crumbs" aria-label="パンくず">
      <a href={`${base}/`}>ホーム</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}/topics/`}>テーマ</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{topic.title}</span>
    </nav>
    <header class="hub-header topic-heading">
      <div>
        <p class="eyebrow">TOPIC / {lessons.length} LESSONS</p>
        <h1>{topic.title}</h1>
        <p>{topic.summary}</p>
      </div>
      <LessonArt id={guide.feature} sizes="(max-width:760px) 160px,240px" />
    </header>
    <section aria-labelledby="topic-articles">
      <h2 id="topic-articles" class="hub-section-title">
        このテーマで読める記事
      </h2>
      <LessonDiscovery topic={topic.id} />
    </section>
    <section class="topic-background" aria-labelledby="topic-questions">
      <h2 id="topic-questions" class="hub-section-title">
        気になっていることから読む
      </h2>
      <p class="topic-intro">{guide.intro}</p>
      <div class="topic-questions">
        {guide.questions.map((q) => (
          <article class="topic-question">
            <h3>{q.title}</h3>
            <p>{q.text}</p>
            <a
              href={`${base}/learn/${q.lesson}/${q.anchor ? `#${q.anchor}` : ""}`}
            >
              この疑問の解説を読む <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section aria-labelledby="topic-neighbors">
      <h2 id="topic-neighbors" class="hub-section-title">
        あわせて考えたいテーマ
      </h2>
      <div class="topic-neighbors">
        {neighbors.map((t) => (
          <article>
            <h3>
              <a href={`${base}/topics/${t.id}/`}>
                {t.title} <span aria-hidden="true">→</span>
              </a>
            </h3>
            <p>{t.summary}</p>
          </article>
        ))}
      </div>
    </section>
    <p class="hub-action">
      <a href={`${base}/library/`}>すべての教材から探す →</a>
    </p>
  </div>
</Shell>
<style>
  .topic-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 24px;
    align-items: center;
  }
  .topic-heading h1 {
    text-wrap: balance;
  }
  .topic-heading p,
  .topic-intro {
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  .topic-background {
    margin-top: 48px;
  }
  .topic-intro {
    margin: 0 0 24px;
    max-width: 40em;
  }
  @media (max-width: 760px) {
    .topic-heading {
      grid-template-columns: 1fr;
    }
    .topic-heading :global(.lesson-art) {
      width: 160px;
    }
  }
</style>
