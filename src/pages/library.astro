---
import Shell from "../layouts/Shell.astro";
import LessonCard from "../components/LessonCard.astro";
import CatalogSearch from "../components/CatalogSearch.astro";
import { getCollection } from "astro:content";
const lessons = (await getCollection("lessons")).sort(
  (a, b) =>
    b.data.updated.localeCompare(a.data.updated) || a.id.localeCompare(b.id),
);
---

<Shell
  title="教材を探す"
  description="テーマ、前提知識、教材の種類からAIセキュリティの教材を探す。"
>
  <div class="wrap hub-page">
    <header class="hub-header">
      <p class="eyebrow">THE FIELD LIBRARY</p>
      <h1>教材を探す</h1>
      <p>気になるテーマから。必要な知識から。</p>
    </header>
    <nav class="catalog-topic-links" aria-label="テーマから探す">
      <a href={`${import.meta.env.BASE_URL}topics/`}>8つのテーマから探す →</a>
    </nav>
    <CatalogSearch />
    <h2 class="hub-section-title" id="all-lessons">
      すべての教材
    </h2>
    <div
      id="catalog-results"
      role="region"
      class="catalog-list"
      tabindex="-1"
      aria-label="教材の検索結果"
    >
      {lessons.map((lesson) => (
        <LessonCard headingLevel="h3" lesson={lesson} poster />
      ))}
    </div>
    <nav
      id="catalog-pagination"
      class="catalog-pagination"
      aria-label="検索結果のページ"
      hidden
    ></nav>
  </div>
</Shell>

<style>
  #catalog-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    border: 0;
  }
  #catalog-results :global([hidden]) {
    display: none !important;
  }
  @media (max-width: 1100px) {
    #catalog-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    #catalog-results {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
