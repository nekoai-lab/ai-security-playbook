---
import { getCollection, render } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import ExplorerNote from "../../components/ExplorerNote.astro";
import DataTable from "../../components/DataTable.astro";
import LearningContext from "../../components/LearningContext.astro";
import CardArt from "../../components/CardArt.astro";
import ArticleLabel from "../../components/ArticleLabel.astro";
import { lessonCardArt } from "../../data/card-art";
import type { LessonVisualId } from "../../data/lesson-visuals";
import { topicTitle, seriesFor } from "../../data/catalog";
export async function getStaticPaths() {
  return (await getCollection("lessons")).map((lesson) => ({
    params: { id: lesson.id },
    props: { lesson },
  }));
}
const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const all = await getCollection("lessons");
const group = seriesFor(lesson.id);
const nextId = group
  ? (group.ids[group.ids.indexOf(lesson.id) + 1] ??
    lesson.data.related.find((id: string) => !group.ids.includes(id)))
  : undefined;
const related = lesson.data.related.length
  ? lesson.data.related
      .map((id: string) => all.find((l) => l.id === id))
      .filter((l): l is NonNullable<typeof l> => Boolean(l) && l!.id !== nextId)
      .slice(0, 2)
  : all
      .filter(
        (l) =>
          l.data.topic === lesson.data.topic &&
          l.id !== lesson.id &&
          l.id !== nextId,
      )
      .slice(0, 2);
const prerequisites = lesson.data.prerequisites.map((id: string) =>
  all.find((l) => l.id === id)!,
);
---

<Shell
  title={lesson.data.title}
  description={lesson.data.summary}
  articleId={lesson.id}
>
  <div class="wrap article-wrap">
    <nav class="crumbs" aria-label="パンくず">
      <a href={`${base}/library/`}>教材一覧</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}/topics/${lesson.data.topic}/`}>
        {topicTitle(lesson.data.topic)}
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">
        {lesson.data.shortTitle ?? lesson.data.title}
      </span>
    </nav>
    <header
      class:list={[
        "article-header",
        { "article-header--narrative": lesson.data.qualityVersion === 2 },
      ]}
    >
      <p class="eyebrow">
        {lesson.data.format} / 約{lesson.data.minutes}分
      </p>
      <h1>{lesson.data.title}</h1>
      <p>{lesson.data.summary}</p>
      <p class="reading-readiness" data-reading-readiness>
        <strong>{lesson.data.level}</strong> · {lesson.data.prerequisiteNote}
      </p>
      <details class="article-preparation">
        <summary>読む前の補足</summary>

        {lesson.data.outcomes && (
          <ul>
            {lesson.data.outcomes.map((goal) => (
              <li>{goal}</li>
            ))}
          </ul>
        )}
        {prerequisites.length > 0 && (
          <nav class="lesson-prerequisites" aria-label="先に読むと役立つ教材">
            <span>仕組みから知りたいときは</span>
            {prerequisites.map((l) => (
              <a href={`${base}/learn/${l.id}/`}>{l.data.title} →</a>
            ))}
          </nav>
        )}
      </details>
      <p class="metadata">
        <span>
          公開{" "}
          <time datetime={lesson.data.published}>{lesson.data.published}</time>
        </span>
        <span>
          内容更新{" "}
          <time datetime={lesson.data.updated}>{lesson.data.updated}</time>
        </span>
        <span>
          情報確認{" "}
          <time datetime={lesson.data.reviewed}>{lesson.data.reviewed}</time>
        </span>
      </p>
    </header>
    <div class="article-grid">
      <aside
        class:list={{
          "article-toc-optional": true,
        }}
      >
        <nav aria-label="この教材の目次">
          <p class="eyebrow">ON THIS PAGE</p>
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
      </aside>
      <article
        class:list={[
          "prose",
          { "article-narrative": lesson.data.qualityVersion === 2 },
        ]}
      >
        {
          <details class="article-mobile-toc">
            <summary>この記事の目次</summary>
            <nav aria-label="この教材の目次">
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => (
                  <a href={`#${h.slug}`}>{h.text}</a>
                ))}
            </nav>
          </details>
        }
        <Content components={{ table: DataTable }} />
        {lesson.data.qualityVersion !== 2 && (
          <ExplorerNote title="読んだことを、ひとつ確かめよう。" compact>
            気になった項目を実際の環境で確認し、分かったことと未確認のことを分けて残しましょう。
          </ExplorerNote>
        )}
        <LearningContext id={lesson.id} />
        {related.length > 0 && (
          <section class="related-lessons">
            <h2>関連する教材</h2>
            <div class="related-grid">
              {related.map((l) => (
                <a
                  class="related-card image-card"
                  href={`${base}/learn/${l.id}/`}
                >
                  <CardArt
                    art={lessonCardArt(l.id as LessonVisualId)}
                    sizes="(max-width:760px) calc(100vw - 32px),320px"
                  />
                  <div class="card-copy">
                    <strong>
                      <ArticleLabel>{l.data.title} →</ArticleLabel>
                    </strong>
                    <span>
                      約{l.data.minutes}分 · {l.data.format}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
        <p class="hub-action">
          <a href={`${base}/topics/${lesson.data.topic}/`}>
            {topicTitle(lesson.data.topic)}の教材へ戻る →
          </a>
        </p>
        <p class="edit-link">
          <a
            href={`https://github.com/nekoai-lab/ai-security-playbook/blob/main/src/content/lessons/${lesson.id}.mdx`}
          >
            この教材のソース・修正提案 ↗
          </a>
        </p>
      </article>
    </div>
  </div>
</Shell>

<style>
  .reading-readiness {
    font-size: 16px;
    line-height: 1.9;
    max-width: 40em;
    text-wrap: balance;
  }
</style>
