---
import Shell from "../layouts/Shell.astro";
import FieldButton from "../components/FieldButton.astro";
import FieldIcon from "../components/FieldIcon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PathCard from "../components/PathCard.astro";
import { learningPaths } from "../data/learning-paths";
import { getCollection } from "astro:content";
const lessons = (await getCollection("lessons")).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (id: string) => `${base}/learn/${id}/`;
---

<Shell title="AIの安全を、解き明かそう。">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">FIELD NOTES / VOL. 01</p>
      <h1>
        AIの安全を、
        <br />
        <em>解き明かそう。</em>
      </h1>
      <p class="hero-description">
        AIを安心して使いこなすための、
        <br />
        実践的なセキュリティ知識を。
        <br />
        仕組みからリスク、対策まで、
        <br />
        確かめながら学ぶプレイブック。
      </p>
      <FieldButton href="#paths">学びをはじめる</FieldButton>
      <div class="hero-byline">
        <strong>by nekoai lab</strong>
        <span>日本語 / 無料・オープンソース</span>
      </div>
    </div>
    <figure class="hero-art">
      <img
        src={`${base}/images/field-notes-hero-1536.webp`}
        srcset={`${base}/images/field-notes-hero-768.webp 768w, ${base}/images/field-notes-hero-1536.webp 1536w`}
        sizes="(max-width: 760px) 100vw, 62vw"
        width="1536"
        height="1024"
        alt="幾何学的なプロセッサー、ツール、記憶装置をオレンジの配線でつないだ分解図と、山から見渡す猫の探検家"
        fetchpriority="high"
      />
      <figcaption>
        <span>OBSERVE / VERIFY / PROTECT</span>
        <span>仕組みを見渡す、最初の一歩。</span>
      </figcaption>
    </figure>
  </section>
  <div class="manifesto-band">
    <div class="wrap">
      <FieldIcon kind="compass" />
      <div>
        <strong>AIと社会のこれからを、ともに探究する。</strong>
        <p>技術・リスク・実践 ― 現場で使える知識を、一つずつ。</p>
      </div>
      <span class="band-code">OBSERVE / VERIFY / PROTECT</span>
    </div>
  </div>
  <section id="paths" class="wrap routes-section">
    <SectionHeading
      eyebrow="LEARNING ROUTES"
      title="目的に合わせて、最適なルートで学べます。"
    >
      <p>
        基礎から実践まで、レベル別に体系化。
        <br />
        あなたのペースで、確かなスキルを。
      </p>
      <FieldIcon kind="compass" />
      <span class="side-note">
        A SAFER AI.
        <br />A BRIGHTER TOMORROW.
      </span>
    </SectionHeading>
    <div class="path-grid">
      {learningPaths.map((path) => (
        <PathCard path={path} lessons={lessons} />
      ))}
    </div>
  </section>
  <section id="latest" class="wrap featured-section">
    <div class="featured-heading">
      <p class="eyebrow">FEATURED LESSON / 01</p>
      <time datetime="2026-10-23">2026.10.23 更新</time>
    </div>
    <a class="featured-card" href={link("node-october-2026")}>
      <div class="featured-art">
        <div class="featured-art-copy">
          <span class="eyebrow">RUNTIME / SECURITY</span>
          <strong>Node.js</strong>
          <span>
            2026年10月
            <br />
            セキュリティ更新
          </span>
        </div>
        <img
          src={`${base}/images/field-notes-hero-768.webp`}
          width="768"
          height="512"
          loading="lazy"
          alt=""
        />
      </div>
      <div class="featured-copy">
        <span class="tag">注目のレッスン</span>
        <h2>
          更新した。
          <br />
          でも、動いているのは？
        </h2>
        <p>
          Node.js 2026年10月セキュリティ更新。
          <br />
          PC・MCP・本番の実行環境をたどり、
          <br />
          確認すべき場所を見つけます。
        </p>
        <span class="feature-link">
          教材を読む <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  </section>
  <section id="library" class="wrap library-section">
    <div class="library-heading">
      <SectionHeading
        eyebrow="THE FIELD LIBRARY"
        title="読む。確かめる。実践する。"
        number="02"
      />
      <span class="mono">
        {String(lessons.length).padStart(2, "0")} FIELD NOTES
      </span>
    </div>
    <div class="lesson-list">
      {lessons.map((l, i) => (
        <a class="lesson-row" href={link(l.id)}>
          <span class="lesson-num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <span class="category">
              {l.data.category} / {l.data.minutes}分
            </span>
            <h3>{l.data.title}</h3>
            <p>{l.data.summary}</p>
          </div>
          <span class="lesson-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="wrap future-section">
    <div>
      <p class="eyebrow">NEXT EXPEDITIONS</p>
      <h2>
        まだ知らない仕組みを、
        <br />
        次の学びへ。
      </h2>
      <p>
        MCP・AIエージェント・クラウド。
        <br />
        このフィールドノートは、少しずつ広がります。
      </p>
    </div>
    <div class="future-topics">
      <span>
        <b>01</b> MCP <small>教材を追加予定</small>
      </span>
      <span>
        <b>02</b> AIエージェント <small>教材を追加予定</small>
      </span>
      <span>
        <b>03</b> クラウド <small>教材を追加予定</small>
      </span>
    </div>
  </section>
</Shell>
