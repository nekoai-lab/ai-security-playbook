---
import Shell from "../layouts/Shell.astro";
import FeaturedLessonCard from "../components/FeaturedLessonCard.astro";
import { featuredLessons } from "../data/featured-lessons";
import ReadingCard from "../components/ReadingCard.astro";
import ExplorerNote from "../components/ExplorerNote.astro";
import FieldButton from "../components/FieldButton.astro";
import FieldIcon from "../components/FieldIcon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TopicCards from "../components/TopicCards.astro";
import { learningPaths } from "../data/learning-paths";
import { getCollection } from "astro:content";
const lessons = (await getCollection("lessons")).sort(
  (a, b) =>
    b.data.updated.localeCompare(a.data.updated) || a.id.localeCompare(b.id),
);
const recent = lessons.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (id: string) => `${base}/learn/${id}/`;
---

<Shell title="AIの安全を、解き明かそう。">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">FIELD NOTES / VOL. 01</p>
      <h1>
        AIの安全を、
        <br />
        <em>解き明かそう。</em>
      </h1>
      <p class="hero-description">
        AIを安心して使いこなすための、
        <br />
        実践的なセキュリティ知識を。
        <br />
        仕組みからリスク、対策まで、
        <br />
        確かめながら学ぶプレイブック。
      </p>
      <FieldButton href={`${base}/library/`}>教材を探す</FieldButton>
    </div>
    <figure class="hero-art">
      <img
        src={`${base}/images/field-notes-hero-1536.webp`}
        srcset={`${base}/images/field-notes-hero-768.webp 768w, ${base}/images/field-notes-hero-1536.webp 1536w`}
        sizes="(max-width: 760px) 100vw, 62vw"
        width="1536"
        height="1024"
        alt="幾何学的なプロセッサー、ツール、記憶装置をオレンジの配線でつないだ分解図と、山から見渡す猫の探検家"
        fetchpriority="high"
      />
      <figcaption>
        <span>OBSERVE / VERIFY / PROTECT</span>
        <span>仕組みを見渡す、最初の一歩。</span>
      </figcaption>
    </figure>
  </section>
  <div class="manifesto-band">
    <div class="wrap">
      <FieldIcon kind="compass" />
      <div>
        <strong>AIと社会のこれからを、ともに探究する。</strong>
        <p>技術・リスク・実践 ― 現場で使える知識を、一つずつ。</p>
      </div>
    </div>
  </div>
  <section class="wrap home-reading" aria-labelledby="home-reading-title">
    <p class="eyebrow">FIELD READING</p>
    <h2 id="home-reading-title">こんな疑問、ありませんか？</h2>
    <div class="reading-card-grid">
      <ReadingCard id="api-keys" />
      <ReadingCard id="node-october-2026" />
    </div>
  </section>
  <section id="library" class="wrap home-topics">
    <SectionHeading
      eyebrow="EXPLORE THE FIELD"
      title="テーマから、知りたいことへ。"
      number="01"
    />
    <TopicCards headingLevel="h3" />
    <p class="hub-action">
      <a href={`${base}/library/`}>教材を検索する →</a>
    </p>
  </section>
  <section id="paths" class="wrap home-paths">
    <SectionHeading
      eyebrow="LEARNING ROUTES"
      title="目的に合わせて、読み進める。"
      number="02"
    />
    <ExplorerNote title="はじめての方は、ここから。" compact>
      「AIで個人開発をはじめる」から、情報・仕組み・秘密の扱いを学べます。公開前やAI連携の確認も、目的別に選べます。
    </ExplorerNote>
    <div class="home-route-links">
      {learningPaths.slice(0, 3).map((path) => (
        <a href={`${base}/paths/${path.id}/`}>
          <span class="catalog-meta">
            {path.audience} · {path.time}
          </span>
          <strong>{path.label} →</strong>
        </a>
      ))}
    </div>
    <p class="hub-action">
      <a href={`${base}/paths/`}>学習ルートを見る →</a>
    </p>
  </section>
  <section
    id="latest"
    class="wrap home-featured"
    aria-labelledby="featured-title"
  >
    <p class="eyebrow">FEATURED LESSONS</p>
    <h2 id="featured-title">いま読んでおきたい教材</h2>
    <p class="featured-intro">
      仕事のAI利用から、アプリの公開・運用まで。いまの疑問に合う一冊を。
    </p>
    <div class="reading-card-grid">
      {featuredLessons.map((lesson) => (
        <FeaturedLessonCard lesson={lesson} />
      ))}
    </div>
    <p class="hub-action">
      <a href={`${base}/library/`}>すべての教材から探す →</a>
    </p>
  </section>
  <section class="wrap home-updates">
    <SectionHeading eyebrow="FIELD UPDATES" title="新着・更新" number="03" />
    <ol class="update-list compact-updates">
      {recent.map((lesson) => (
        <li>
          <p class="catalog-meta">
            <time datetime={lesson.data.updated}>{lesson.data.updated}</time> ·{" "}
            {lesson.data.updated === lesson.data.published ? "公開" : "更新"}
          </p>
          <h3>
            <a href={link(lesson.id)}>{lesson.data.title} →</a>
          </h3>
          <p>{lesson.data.changes[0]?.summary ?? lesson.data.summary}</p>
        </li>
      ))}
    </ol>
    <p class="hub-action">
      <a href={`${base}/updates/`}>新着・更新をすべて見る →</a>
    </p>
  </section>
</Shell>

<style>
  .home-paths :global(.explorer-note > div) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .home-featured {
    padding-block: 64px;
  }
  .home-featured > h2 {
    margin: 0 0 16px;
    font-size: 32px;
    line-height: 1.4;
    text-wrap: balance;
  }
  .featured-intro {
    margin: 0 0 32px;
    font-size: 16px;
    line-height: 1.9;
    text-wrap: balance;
  }
  @media (max-width: 760px) {
    .home-featured {
      padding-block: 32px;
    }
    .home-featured > h2 {
      font-size: 24px;
    }
  }
</style>
