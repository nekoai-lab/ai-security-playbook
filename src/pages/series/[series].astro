---
import Shell from "../../layouts/Shell.astro";
import LessonCard from "../../components/LessonCard.astro";
import { getCollection } from "astro:content";
import { series } from "../../data/catalog";
export function getStaticPaths() {
  return series.map((group) => ({
    params: { series: group.id },
    props: { group },
  }));
}
const { group } = Astro.props;
const all = await getCollection("lessons");
const lessons = group.ids.map((id) => all.find((l) => l.id === id)!);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Shell title={group.title} description={group.summary}>
  <div class="wrap hub-page">
    <nav class="crumbs" aria-label="パンくず">
      <a href={`${base}/library/`}>教材一覧</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">シリーズ</span>
    </nav>
    <header class="hub-header">
      <p class="eyebrow">FIELD SERIES</p>
      <h1>{group.title}</h1>
      <p>{group.summary}</p>
      <p class="catalog-meta">
        {lessons.length}教材 · 合計約
        {lessons.reduce((sum, l) => sum + l.data.minutes, 0)}分
      </p>
    </header>
    <ol class="ordered-lessons">
      {lessons.map((lesson, i) => (
        <li>
          <p class="eyebrow">STEP {String(i + 1).padStart(2, "0")}</p>
          <LessonCard lesson={lesson} />
        </li>
      ))}
    </ol>
    <p class="hub-action">
      <a href={`${base}/paths/`}>目的に合う短いルートから読む →</a>
    </p>
  </div>
</Shell>
