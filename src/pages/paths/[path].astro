---
import Shell from "../../layouts/Shell.astro";
import LessonCard from "../../components/LessonCard.astro";
import FieldButton from "../../components/FieldButton.astro";
import { learningPaths } from "../../data/learning-paths";
import { getCollection } from "astro:content";
export function getStaticPaths() {
  return learningPaths.map((path) => ({
    params: { path: path.id },
    props: { path },
  }));
}
const { path } = Astro.props;
const all = await getCollection("lessons");
const lessons = path.ids.map((id) => all.find((l) => l.id === id)!);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Shell title={path.label} description={path.text}>
  <div class="wrap hub-page">
    <nav class="crumbs" aria-label="パンくず">
      <a href={`${base}/paths/`}>学習ルート</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{path.label}</span>
    </nav>
    <header class="hub-header">
      <p class="eyebrow">
        ROUTE {path.num} / {path.audience}
      </p>
      <h1>{path.label}</h1>
      <p>{path.text}</p>
      <p class="catalog-meta">
        {lessons.length}教材 · 合計{path.time}
      </p>
      <FieldButton href={`${base}/learn/${path.ids[0]}/?route=${path.id}`}>
        このルートをはじめる
      </FieldButton>
    </header>
    <h2 class="hub-section-title">この順番で読む</h2>
    <ol class="ordered-lessons">
      {lessons.map((lesson, i) => (
        <li>
          <p class="eyebrow">STEP {String(i + 1).padStart(2, "0")}</p>
          <LessonCard headingLevel="h3" lesson={lesson} route={path.id} />
        </li>
      ))}
    </ol>
    <p class="hub-action">
      <a href={`${base}/paths/`}>ほかの学習ルートを見る →</a>
    </p>
  </div>
</Shell>
