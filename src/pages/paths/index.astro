---
import Shell from "../../layouts/Shell.astro";
import ReaderEntryCards from "../../components/ReaderEntryCards.astro";
import { learningPaths } from "../../data/learning-paths";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Shell title="学習ルート" description="AIを使う・アプリを作る・サービスを守る場面から、前提知識に合う読む順番を選べます。個人開発、公開前の確認、AI連携、更新対応の教材を順に学ぶ案内です。">
  <div class="wrap hub-page">
    <header class="hub-header">
      <p class="eyebrow">LEARNING ROUTES</p>
      <h1>場面と知識から、学びを選ぶ。</h1>
      <p>AIを使う方も、作る方も。自分に合う段階から読めます。</p>
    </header>
    <h2 class="hub-section-title">いまの場面から探す</h2>
    <ReaderEntryCards />
    <h2 class="hub-section-title">順番に学びたいときの短いルート</h2>
    <p>取り組む作業が決まっている方は、関連する教材を順番に読めます。</p>
    <div class="route-grid">
      {learningPaths.map((path) => (
        <a class="route-card" href={`${base}/paths/${path.id}/`}>
          <p class="eyebrow">
            ROUTE {path.num} · {path.audience}
          </p>
          <h2>{path.label}</h2>
          <p>{path.text}</p>
          <span class="catalog-meta">
            {path.ids.length}教材 · {path.time} →
          </span>
        </a>
      ))}
    </div>
  </div>
</Shell>
