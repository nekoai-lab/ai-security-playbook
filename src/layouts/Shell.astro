---
import "../styles/global.css";
import "../styles/library.css";
import "../styles/article-illustrations.css";
import "../styles/card-system.css";
import BrandMark from "../components/BrandMark.astro";
import { mainNavigation, isNavigationCurrent } from "../data/site-navigation";
import { lessonVisuals } from "../data/lesson-visuals";
interface Props {
  title: string;
  description?: string;
  articleId?: string;
}
const {
  title,
  articleId,
  description = "AIを使う人と作る人のための、日本語セキュリティ実践ガイド。",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
if (!Astro.site) throw new Error("OGP requires astro.config site");
const pageTitle = `${title} | AI Security Playbook`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const socialTitle = articleId ? title : pageTitle;
const socialImage = new URL(
  `${base}/ogp/${articleId && Object.hasOwn(lessonVisuals, articleId) ? articleId : "default"}.png`,
  Astro.site,
).href;
const socialAlt = articleId
  ? `${title} — AI Security Playbookの教材カード`
  : "AIの安全を、解き明かそう。羅針盤と猫のロゴ：AI Security Playbook";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="AI Security Playbook" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={articleId ? "article" : "website"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/brand/compass-cat-32.png`}
    />
    <link rel="apple-touch-icon" href={`${base}/brand/compass-cat-180.png`} />
    <meta name="theme-color" content="#f5f1e6" />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="header">
      <a class="brand" href={`${base}/`}>
        <BrandMark size={64} class="brand-cat" />
        <span>
          <span class="brand-name">AI Security Playbook</span>
        </span>
      </a>
      <nav aria-label="メイン">
        {mainNavigation.map((item) => (
          <a
            href={`${base}${item.path}`}
            aria-current={
              isNavigationCurrent(Astro.url.pathname, base, item.sections)
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-brand">
        <BrandMark size={48} />
        <p>
          AI SECURITY PLAYBOOK<small>仕組みを知ることが、守る力になる。</small>
          <small data-site-publisher>制作・運営：Tsukineko</small>
        </p>
      </div>
      <div class="footer-links">
        <a href={`${base}/about/`}>このサイトについて</a>
        <a href="https://github.com/nekoai-lab/ai-security-playbook/blob/main/LICENSE">
          MIT License
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer-brand {
    gap: 12px;
  }
</style>
