---
import "../styles/global.css";
import FieldIcon from "../components/FieldIcon.astro";
import BrandMark from "../components/BrandMark.astro";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "AIを使う人と作る人のための、日本語セキュリティ実践ガイド。",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | AI Security Playbook</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/brand/compass-cat-32.png`}
    />
    <link rel="apple-touch-icon" href={`${base}/brand/compass-cat-180.png`} />
    <meta name="theme-color" content="#f5f1e6" />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="header">
      <a class="brand" href={`${base}/`}>
        <BrandMark size={64} class="brand-cat" />
        <span>
          AI Security
          <br />
          Playbook<small>by nekoai lab</small>
        </span>
      </a>
      <nav aria-label="メイン">
        <a href={`${base}/#paths`}>学習ルート</a>
        <a href={`${base}/#library`}>教材</a>
        <a href={`${base}/#latest`}>最新の教材</a>
      </nav>
      <a
        class="header-github"
        href="https://github.com/nekoai-lab/ai-security-playbook"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-brand">
        <FieldIcon kind="compass" />
        <p>
          AI SECURITY PLAYBOOK<small>仕組みを知ることが、守る力になる。</small>
        </p>
      </div>
      <div class="footer-links">
        <a href={`${base}/design-system/`}>デザインガイド</a>
        <a href="https://github.com/nekoai-lab/ai-security-playbook/blob/main/LICENSE">
          MIT License
        </a>
        <span>by Tsukineko / nekoai lab</span>
      </div>
    </footer>
  </body>
</html>
