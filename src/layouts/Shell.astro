---
import "../styles/global.css";
import "../styles/library.css";
import "../styles/article-illustrations.css";
import "../styles/card-system.css";
import "../styles/mountain-backdrop.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CreatorLinks from "../components/CreatorLinks.astro";
import { creator } from "../data/creator";
import BrandMark from "../components/BrandMark.astro";
import { mainNavigation, isNavigationCurrent } from "../data/site-navigation";
import { lessonVisuals } from "../data/lesson-visuals";
interface Props {
  title: string;
  description?: string;
  articleId?: string;
  mountainBackdrop?: boolean;
}
const {
  title,
  articleId,
  mountainBackdrop = false,
  description = "AIを使う人と作る人のための、日本語セキュリティ実践ガイド。",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
if (!Astro.site) throw new Error("OGP requires astro.config site");
const pageTitle = `${title} | AI Security Playbook`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const socialTitle = articleId ? title : pageTitle;
const socialImage = new URL(
  `${base}/ogp/${articleId && Object.hasOwn(lessonVisuals, articleId) ? articleId : "default"}.png`,
  Astro.site,
).href;
const socialAlt = articleId
  ? `${title} — AI Security Playbookの教材カード`
  : "AIの安全を、解き明かそう。羅針盤と猫のロゴ：AI Security Playbook";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <GoogleAnalytics />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={creator.name} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="AI Security Playbook" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={articleId ? "article" : "website"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/brand/compass-cat-32.png`}
    />
    <link rel="apple-touch-icon" href={`${base}/brand/compass-cat-180.png`} />
    <meta name="theme-color" content="#f5f1e6" />
  </head>
  <body>
    {mountainBackdrop && (
      <picture class="mountain-backdrop" aria-hidden="true">
        <source media="(min-width: 1280px)" srcset={`${base}/images/alpine-panorama-1920.webp 1920w, ${base}/images/alpine-panorama-2560.webp 2560w`} sizes="100vw" />
        <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" width="2560" height="1066" decoding="async" />
      </picture>
    )}
    <div class:list={["site-frame", {"site-frame--mountain": mountainBackdrop}]}>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="header">
      <a class="brand" href={`${base}/`}>
        <BrandMark size={64} class="brand-cat" />
        <span>
          <span class="brand-name">AI Security Playbook</span>
        </span>
      </a>
      <nav aria-label="メイン">
        {mainNavigation.map((item) => (
          <a
            href={`${base}${item.path}`}
            aria-current={
              isNavigationCurrent(Astro.url.pathname, base, item.sections)
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <a class="footer-brand" href={`${base}/`} aria-label="AI Security Playbook トップページへ">
        <BrandMark size={48} />
        <p>
          AI SECURITY PLAYBOOK<small>仕組みを知ることが、守る力になる。</small>
          <small data-site-publisher>制作・運営：Tsukineko</small>
        </p>
      </a>
      <div class="footer-links">
        <a href={`${base}/about/`}>このサイトについて</a>
        <a href={`${base}/terms/`}>著作権・利用条件</a>
        <a href={`${base}/privacy/`}>プライバシー</a>
        <CreatorLinks label="フッターの発信先・お問い合わせ" />
        <small class="copyright">© 2026 Tsukineko</small>
      </div>
    </footer>
    </div>
  </body>
</html>

<style>
  .copyright { font-size: 12px; color: var(--color-muted); }
  .footer-brand {
    gap: 12px;
    min-height: 44px;
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }
</style>
