---
import "../styles/global.css";
import FieldIcon from "../components/FieldIcon.astro";
import BrandMark from "../components/BrandMark.astro";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "AIを使う人と作る人のための、日本語セキュリティ実践ガイド。",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | AI Security Playbook</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/brand/compass-cat-32.png`}
    />
    <link rel="apple-touch-icon" href={`${base}/brand/compass-cat-180.png`} />
    <meta name="theme-color" content="#f5f1e6" />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="header">
      <a class="brand" href={`${base}/`}>
        <BrandMark size={64} class="brand-cat" />
        <span>
          <span class="brand-name">AI Security Playbook</span>
          <small>by nekoai lab</small>
        </span>
      </a>
      <nav aria-label="メイン">
        <a href={`${base}/#paths`}>学習ルート</a>
        <a href={`${base}/#library`}>教材一覧</a>
        <a href={`${base}/#latest`}>最新の教材</a>
      </nav>
      <a
        class="header-github" aria-label="GitHubでソースを見る" title="GitHubでソースを見る"
        href="https://github.com/nekoai-lab/ai-security-playbook"
      >
        <span class="github-label">GitHub</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.07-1.15 3.07-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>
      </a>
    </header>
    <script>
      const syncNavigation = () => {
        document.querySelectorAll<HTMLAnchorElement>(".header nav a").forEach((link) => {
          const target = new URL(link.href);
          if (target.pathname === location.pathname && target.hash === location.hash) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };
      syncNavigation();
      window.addEventListener("hashchange", syncNavigation);
    </script>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-brand">
        <FieldIcon kind="compass" />
        <p>
          AI SECURITY PLAYBOOK<small>仕組みを知ることが、守る力になる。</small>
        </p>
      </div>
      <div class="footer-links">
        <a href={`${base}/design-system/`}>デザインガイド</a>
        <a href="https://github.com/nekoai-lab/ai-security-playbook/blob/main/LICENSE">
          MIT License
        </a>
        <span>by Tsukineko / nekoai lab</span>
      </div>
    </footer>
  </body>
</html>
